<Window x:Class="WAFlow.Desktop.Windows.AgentTaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Sales OS · Agent Task" Icon="/AISalesOS;component/Assets/AI-Sales-OS.ico"
        Width="780" Height="680" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,19">
            <Grid>
                <StackPanel><TextBlock Text="AGENT TASK AUDIT" Style="{StaticResource PageEyebrow}"/><TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="MetaText" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource PrimarySoft}" CornerRadius="10" Padding="10,6"><TextBlock x:Name="StatusText" Foreground="{DynamicResource PrimaryDark}" FontWeight="SemiBold"/></Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="执行摘要" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SummaryText" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="发送范围" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ApprovalText" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ContextText" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border x:Name="MissingCard" Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Agent 建议补充" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="MissingText" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock Text="这些问题不会自动发送给客户。请由你决定是否询问、忽略或之后 Refine Search。" Foreground="{DynamicResource Warning}" FontSize="9.5" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Expander Header="查看规范化结果 JSON（外部不可信数据）" Margin="0,14,0,0"><TextBox x:Name="ResultJsonBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="180" Margin="0,9,0,0" AutomationProperties.Name="Agent Task 规范化结果 JSON"/></Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14"><Button Content="完成" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Close_Click"/></Border>
    </Grid>
</Window>
