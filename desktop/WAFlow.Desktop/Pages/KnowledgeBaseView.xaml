<UserControl x:Class="WAFlow.Desktop.Pages.KnowledgeBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CUSTOMER KNOWLEDGE &amp; RAG" Style="{StaticResource PageEyebrow}"/>
                <TextBlock Text="让 AI 先查证，再回答" Style="{StaticResource PageTitle}" Margin="0,4,0,0"/>
                <TextBlock Text="批准资料、真实互动和结果验证经验分层治理；所有检索都受作用域、版本、冲突、时效和人工接管约束。"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NewVersionButton" Content="上传新版本" Style="{StaticResource SecondaryButton}"
                        IsEnabled="False" Click="NewVersion_Click" Margin="0,0,8,0"/>
                <Button x:Name="UploadButton" Content="＋ 上传知识" Style="{StaticResource PrimaryButton}" Click="Upload_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" ToolTip="搜索标题、摘要、标签与文件名" TextChanged="Filter_Changed" Margin="0,0,9,0"/>
                <ComboBox x:Name="StatusFilter" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" Margin="0,0,9,0"/>
                <ComboBox x:Name="ScopeFilter" Grid.Column="2" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" Margin="0,0,9,0"/>
                <Button Grid.Column="3" Content="刷新" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="15,12" CornerRadius="16,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="知识文件" FontWeight="SemiBold" FontSize="15"/>
                            <Border Grid.Column="1" Background="{DynamicResource PrimarySoft}" CornerRadius="9" Padding="8,4">
                                <TextBlock x:Name="DocumentCountText" Text="0 项" Foreground="{DynamicResource Primary}" FontSize="9.5" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ListBox x:Name="DocumentList" Grid.Row="1" BorderThickness="0" SelectionChanged="DocumentList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,7" ToolTip="{Binding Summary}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding OriginalFileName}" Foreground="{DynamicResource Muted}" FontSize="9.5"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource Primary}" FontSize="9.5"/>
                                            <TextBlock Text=" · " Foreground="{DynamicResource Muted}" FontSize="9.5"/>
                                            <TextBlock Text="{Binding ScopeLabel}" Foreground="{DynamicResource Muted}" FontSize="9.5"/>
                                            <TextBlock Text=" · " Foreground="{DynamicResource Muted}" FontSize="9.5"/>
                                            <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource Muted}" FontSize="9.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource CanvasDeep}" CornerRadius="8" Padding="7,4" VerticalAlignment="Top" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource Ink}" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,9" CornerRadius="0,0,16,16">
                        <TextBlock x:Name="LibraryStatusText" Text="等待载入知识库" Foreground="{DynamicResource Muted}" FontSize="9.5" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,11" CornerRadius="16,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="DetailTitleText" Text="选择知识文件" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Name="DetailMetaText" Text="查看版本、原文、知识块、冲突与检索结果" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DownloadButton" Content="下载原件" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="Download_Click" Margin="0,0,7,0"/>
                                <Button x:Name="DisableButton" Content="停用" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="Disable_Click" Margin="0,0,7,0"/>
                                <Button x:Name="ActivateButton" Content="审核并启用" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Activate_Click" Margin="0,0,7,0"/>
                                <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource DangerButton}" IsEnabled="False" Click="Delete_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl x:Name="DetailTabs" Grid.Row="1" BorderThickness="0">
                        <TabItem Header="概览与审核">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,16,18,22">
                                    <Border x:Name="RiskBanner" Background="{DynamicResource WarningSoft}" CornerRadius="11" Padding="13" Visibility="Collapsed" Margin="0,0,0,12">
                                        <TextBlock x:Name="RiskText" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="标题" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="MetadataTitleBox" Margin="0,4,0,10"/>
                                            <TextBlock Text="分类" Style="{StaticResource LabelText}"/>
                                            <ComboBox x:Name="MetadataCategoryBox" DisplayMemberPath="Label" Margin="0,4,0,10"/>
                                            <TextBlock Text="使用方式" Style="{StaticResource LabelText}"/>
                                            <ComboBox x:Name="MetadataUsageBox" DisplayMemberPath="Label" Margin="0,4,0,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="标签（逗号分隔）" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="MetadataTagsBox" Margin="0,4,0,10"/>
                                            <TextBlock Text="生效日期（可选）" Style="{StaticResource LabelText}"/>
                                            <DatePicker x:Name="EffectiveFromPicker" Margin="0,4,0,10"/>
                                            <TextBlock Text="失效日期（可选）" Style="{StaticResource LabelText}"/>
                                            <DatePicker x:Name="EffectiveUntilPicker" Margin="0,4,0,10"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="SaveMetadataButton" Content="保存审核信息" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" Click="SaveMetadata_Click" IsEnabled="False"/>
                                    <Separator Margin="0,14"/>
                                    <TextBlock Text="自动摘要" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="SummaryText" Text="选择文件后显示" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Text="处理信息" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
                                    <TextBlock x:Name="ProcessingText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="原文预览">
                            <TextBox x:Name="PreviewTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     Margin="14" Padding="14" Background="{DynamicResource SurfaceMuted}"/>
                        </TabItem>
                        <TabItem Header="知识块">
                            <DataGrid x:Name="ChunkGrid" IsReadOnly="True" AutoGenerateColumns="False" Margin="12" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="48"/>
                                    <DataGridTextColumn Header="位置" Binding="{Binding Locator}" Width="140"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding Heading}" Width="160"/>
                                    <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"/>
                                    <DataGridTextColumn Header="关键词" Binding="{Binding KeywordsLabel}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="版本与冲突">
                            <Grid Margin="14">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid x:Name="VersionGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="版本" Binding="{Binding VersionLabel}" Width="70"/>
                                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="180"/>
                                        <DataGridTextColumn Header="SHA-256" Binding="{Binding HashShort}" Width="150"/>
                                        <DataGridTextColumn Header="解析器" Binding="{Binding Parser}" Width="120"/>
                                        <DataGridTextColumn Header="块数" Binding="{Binding ChunkCount}" Width="70"/>
                                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ConflictGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                        <DataGridTextColumn Header="主题" Binding="{Binding Topic}" Width="150"/>
                                        <DataGridTextColumn Header="冲突说明" Binding="{Binding Detail}" Width="*"/>
                                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="3" Content="人工确认保留当前文档" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" Margin="0,8,0,0" Click="ResolveConflict_Click"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="知识候选">
                            <Grid Margin="14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="10" Padding="11" Margin="0,0,0,9">
                                    <TextBlock Text="候选只来自真实发送与客户结果观察；AI 未发送草稿不会出现。低样本只能标记为“初步观察”，所有候选都必须人工审批后才能发布。"
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                </Border>
                                <DataGrid x:Name="CandidateGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                          SelectionChanged="CandidateGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="候选" Binding="{Binding Title}" Width="240"/>
                                        <DataGridTextColumn Header="证据等级" Binding="{Binding EvidenceLabel}" Width="100"/>
                                        <DataGridTextColumn Header="样本" Binding="{Binding SampleSize}" Width="60"/>
                                        <DataGridTextColumn Header="回复" Binding="{Binding Replies}" Width="60"/>
                                        <DataGridTextColumn Header="阶段推进" Binding="{Binding StageProgressions}" Width="75"/>
                                        <DataGridTextColumn Header="成交" Binding="{Binding Conversions}" Width="60"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                        <DataGridTextColumn Header="话术内容" Binding="{Binding Content}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                                    <Button x:Name="RejectCandidateButton" Content="拒绝" Style="{StaticResource DangerButton}" Click="RejectCandidate_Click" IsEnabled="False" Margin="0,0,7,0"/>
                                    <Button x:Name="ApproveCandidateButton" Content="人工批准" Style="{StaticResource SecondaryButton}" Click="ApproveCandidate_Click" IsEnabled="False" Margin="0,0,7,0"/>
                                    <Button x:Name="PublishCandidateButton" Content="发布为待审核知识" Style="{StaticResource PrimaryButton}" Click="PublishCandidate_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="检索测试">
                            <Grid Margin="15">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="RetrievalQueryBox" ToolTip="例如：客户询问交付费用和时间时应该如何回复？" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="执行真实检索" Style="{StaticResource PrimaryButton}" Click="RetrievalTest_Click"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="RetrievalAccountBox" ToolTip="可选：账号 ID" Margin="0,0,7,0"/>
                                    <TextBox x:Name="RetrievalCustomerBox" Grid.Column="1" ToolTip="可选：客户 ID" Margin="0,0,7,0"/>
                                    <TextBox x:Name="RetrievalConversationBox" Grid.Column="2" ToolTip="可选：会话 ID"/>
                                </Grid>
                                <Border x:Name="RetrievalSummaryBorder" Grid.Row="2" Background="{DynamicResource PrimarySoft}" CornerRadius="10" Padding="11" Margin="0,9,0,9" Visibility="Collapsed">
                                    <TextBlock x:Name="RetrievalSummaryText" Foreground="{DynamicResource PrimaryDark}" TextWrapping="Wrap"/>
                                </Border>
                                <DataGrid x:Name="RetrievalGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="相关度" Binding="{Binding ScoreLabel}" Width="80"/>
                                        <DataGridTextColumn Header="来源" Binding="{Binding Citation}" Width="210"/>
                                        <DataGridTextColumn Header="作用域" Binding="{Binding Scope}" Width="110"/>
                                        <DataGridTextColumn Header="命中内容" Binding="{Binding Content}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
