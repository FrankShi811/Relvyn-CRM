<Window x:Class="WAFlow.Desktop.Windows.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Sales OS · 导入客户" Icon="/AISalesOS;component/Assets/AI-Sales-OS.ico"
        Width="1120" Height="760" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="导入 Excel / CSV 客户表" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="先检查字段映射和实际变更，再由你确认写入；默认保护已有客户的负责人和阶段。" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="单文件 200MB · 不设固定行数上限" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border x:Name="Step1Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Primary}"><TextBlock Text="1" Foreground="{DynamicResource SidebarText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                <TextBlock Text="选择文件" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="Step2Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource LineStrong}"><TextBlock Text="2" Foreground="{DynamicResource SidebarText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                <TextBlock Text="检查字段映射" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border x:Name="Step3Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource LineStrong}"><TextBlock Text="3" Foreground="{DynamicResource SidebarText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                <TextBlock Text="确认实际变更" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="24,16,24,16">
            <Border x:Name="SelectPanel" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="选择本地文件" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="支持 .xlsx、UTF-8 / GB18030 CSV；数万行会在后台解析并分批写入。" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource SurfaceMuted}" Margin="0,20,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="▣" FontSize="42" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="选择 Excel 或 CSV 客户表" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="原表的每一个表头和每一个单元格值都会保存在本机数据库。" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                            <Button Content="浏览文件…" Style="{StaticResource PrimaryButton}" Click="Browse_Click" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FilePathText" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" MaxWidth="680" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SheetPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="选择要导入的工作表" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="核对系统识别结果；不确定的列可保留为自定义维度，不会丢失原始值。" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="SheetCombo" Grid.Row="1" Margin="0,18,0,14" SelectionChanged="SheetCombo_SelectionChanged" DisplayMemberPath="Name"
                              AutomationProperties.Name="导入工作表"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="1">
                            <DataGrid x:Name="MappingGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      EnableRowVirtualization="True" HeadersVisibility="Column" BorderThickness="0" MinHeight="250"
                                      AutomationProperties.Name="导入字段映射">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="原表列" Binding="{Binding Header}" Width="1.05*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="示例值" Binding="{Binding Sample}" Width="1.15*" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="写入位置" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.ImportFieldOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="选择导入字段"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="SheetStatsText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                                <TextBlock Text="原始列完整保留" FontWeight="SemiBold" Margin="0,16,0,7"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                                    <TextBlock x:Name="ColumnSummaryText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="22"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="3" Background="{DynamicResource PrimarySoft}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <TextBlock Text="系统会自动识别姓名、电话、国家、负责人等常用列供销售功能使用；即使未识别，原列和原值也不会丢失。重复号码使用非空值更新，历史会话不会被删除。" Foreground="{DynamicResource Primary}"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="PreviewPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="确认本次实际变更" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="下表是写入前的真实预览。存在身份冲突的行会被阻止，不会写入。" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,15,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource PrimarySoft}" CornerRadius="9" Padding="12,9" Margin="0,0,6,0"><StackPanel><TextBlock Text="新增客户" Style="{StaticResource LabelText}"/><TextBlock x:Name="PreviewCreatedText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Primary}"/></StackPanel></Border>
                        <Border Grid.Column="1" Background="{DynamicResource InfoSoft}" CornerRadius="9" Padding="12,9" Margin="6,0"><StackPanel><TextBlock Text="更新客户" Style="{StaticResource LabelText}"/><TextBlock x:Name="PreviewUpdatedText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Info}"/></StackPanel></Border>
                        <Border Grid.Column="2" Background="{DynamicResource WarningSoft}" CornerRadius="9" Padding="12,9" Margin="6,0"><StackPanel><TextBlock Text="号码或字段提醒" Style="{StaticResource LabelText}"/><TextBlock x:Name="PreviewWarningText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Warning}"/></StackPanel></Border>
                        <Border Grid.Column="3" Background="{DynamicResource DangerSoft}" CornerRadius="9" Padding="12,9" Margin="6,0,0,0"><StackPanel><TextBlock Text="阻止写入" Style="{StaticResource LabelText}"/><TextBlock x:Name="PreviewBlockedText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Danger}"/></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="1">
                        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  ScrollViewer.CanContentScroll="True" BorderThickness="0" AutomationProperties.Name="导入变更预览">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" Width="58"/>
                                <DataGridTextColumn Header="客户" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="公司" Binding="{Binding Company}" Width="150"/>
                                <DataGridTextColumn Header="WhatsApp" Binding="{Binding PhoneE164}" Width="135"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="105"/>
                                <DataGridTextColumn Header="将发生的变更" Binding="{Binding Changes}" Width="230"/>
                                <DataGridTextColumn Header="提醒 / 阻止原因" Binding="{Binding ReviewMessage}" Width="300"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="3" Background="{DynamicResource WarningSoft}" CornerRadius="9" Padding="13,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="已有客户保护" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,7,0,0">
                                <CheckBox x:Name="AllowOwnerChangeBox" Content="允许本次导入更新负责人" IsChecked="False" Margin="0,0,24,0"/>
                                <CheckBox x:Name="AllowStageChangeBox" Content="允许本次导入更新销售阶段" IsChecked="False"/>
                            </WrapPanel>
                            <TextBlock Text="两项默认关闭。其他非空字段与原表维度仍按上方预览增量更新。" Foreground="{DynamicResource Warning}" FontSize="10" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}" Click="Back_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
                <StackPanel x:Name="ProgressPanel" Grid.Column="1" Margin="24,0" Visibility="Collapsed">
                    <TextBlock x:Name="ImportProgressText" Text="正在处理" Foreground="{DynamicResource Muted}" FontSize="11" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="ImportProgressBar" Height="5" Minimum="0" Maximum="100" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="NextButton" Content="解析文件" Style="{StaticResource PrimaryButton}" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
