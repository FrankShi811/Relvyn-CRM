<UserControl x:Class="WAFlow.Desktop.Pages.WhatsAppInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WAFlow.Desktop.Controls"
             AutomationProperties.Name="WhatsApp">
    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LIVE SALES CONVERSATIONS" Style="{StaticResource PageEyebrow}"/>
                <TextBlock Text="WhatsApp" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/>
                <TextBlock Text="会话、客户上下文、AI 商机判断与销售动作在同一工作区完成。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                <Border x:Name="IpStatusBorder" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,9,0,0" HorizontalAlignment="Left" ToolTip="监测本机连接 WhatsApp 时使用的公网出口 IP；每 60 秒检测一次。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" x:Name="IpStatusDot" Foreground="{DynamicResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="IpStatusText" Text="公网 IP：检测中…" Foreground="{DynamicResource Muted}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="AccountCombo" Width="160" DisplayMemberPath="DisplayLabel" SelectionChanged="AccountCombo_SelectionChanged" Margin="0,0,8,0" AutomationProperties.Name="当前 WhatsApp 账号"/>
                <Button Content="＋ 账号" Style="{StaticResource SecondaryButton}" Click="AddAccount_Click" Margin="0,0,8,0"/>
                <Border x:Name="ConnectionStateBorder" Background="{DynamicResource WarningSoft}" CornerRadius="13" Padding="10,6" Margin="0,0,10,0"><TextBlock x:Name="ConnectionStateText" Text="未连接" Foreground="{DynamicResource Warning}" FontSize="10.5" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/></Border>
                <Button x:Name="ConnectButton" Content="连接 / 显示二维码" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
                <Button x:Name="AccountActionsButton" Content="账号操作 ▾" Style="{StaticResource SecondaryButton}" Click="AccountActions_Click" Margin="8,0,0,0" IsEnabled="False"
                        ToolTip="断开连接会保留登录；退出账号会清除此电脑的登录会话">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem x:Name="DisconnectMenuItem" Header="断开当前连接（保留登录）" Click="Disconnect_Click" IsEnabled="False"/>
                            <Separator/>
                            <MenuItem x:Name="LogoutMenuItem" Header="退出并清除此电脑登录" Click="Logout_Click" IsEnabled="False"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="LeadSidebarColumn" Width="360"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="会话与联系人" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="ConversationCountText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBlock Text="⌕" FontSize="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" Panel.ZIndex="1" IsHitTestVisible="False"/>
                                    <TextBox x:Name="ConversationSearchBox" ToolTip="输入姓名、WhatsApp 名称或号码，实时搜索" Padding="32,8,10,8" TextChanged="ConversationSearch_TextChanged" AutomationProperties.Name="搜索 WhatsApp 会话与联系人"/>
                                </Grid>
                                <Button x:Name="CreateGroupButton" Grid.Column="1" Content="＋" Style="{StaticResource SecondaryButton}" Click="CreateGroup_Click" Width="38" Height="38" Padding="0" Margin="8,0,0,0" FontSize="20" FontWeight="SemiBold" IsEnabled="False" ToolTip="建立 WhatsApp 群组" AutomationProperties.Name="建立 WhatsApp 群组"/>
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="SyncButton" Content="同步联系人与历史" Style="{StaticResource SecondaryButton}" Click="Sync_Click" Padding="10,6" IsEnabled="False"/>
                                <ComboBox x:Name="LabelFilterCombo" Grid.Column="1" Width="104" FontSize="11" Margin="8,0,0,0" DisplayMemberPath="Name" SelectionChanged="LabelFilter_SelectionChanged" ToolTip="按 WhatsApp 标签筛选会话" AutomationProperties.Name="按 WhatsApp 标签筛选会话"/>
                                <TextBlock x:Name="SyncStatusText" Grid.Column="2" Text="连接后自动同步" Foreground="{DynamicResource Muted}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="ConversationList" Grid.Row="1" BorderThickness="0" SelectionChanged="ConversationList_SelectionChanged" PreviewMouseRightButtonDown="ConversationList_PreviewMouseRightButtonDown" AutomationProperties.Name="WhatsApp 会话与联系人列表">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="9,9" Width="246"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Foreground="{DynamicResource Primary}" FontSize="8" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding PinnedVisibility}" IsHitTestVisible="False"/>
                                        <Border Background="{DynamicResource PrimarySoft}" CornerRadius="6" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding GroupVisibility}">
                                            <TextBlock Text="群聊" Foreground="{DynamicResource PrimaryDark}" FontSize="8.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LastTimeLabel}" Foreground="{DynamicResource Muted}" FontSize="10"/>
                                    <TextBlock Grid.Row="1" Text="{Binding LastMessage}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/>
                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource UnreadBadgeBackground}" CornerRadius="9" MinWidth="18" Height="18" Visibility="{Binding UnreadVisibility}"><TextBlock Text="{Binding Unread}" Foreground="{DynamicResource UnreadBadgeText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0" Visibility="{Binding LabelsVisibility}">
                                        <ItemsControl ItemsSource="{Binding VisibleLabels}" ItemTemplate="{StaticResource WhatsAppLabelChipTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="5" Padding="5,2" Margin="0,1,0,1" Visibility="{Binding AdditionalLabelsVisibility}" ToolTip="{Binding LabelsToolTip}">
                                            <TextBlock Text="{Binding AdditionalLabelsText}" Foreground="{DynamicResource Muted}" FontSize="9.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="18,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ChatTitleText" Text="选择会话" FontWeight="SemiBold" FontSize="17"/>
                                    <TextBlock x:Name="ChatNumberText" Text="连接后会同步个人与群聊会话" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="ChatLabelButton" Content="标签" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="11,4" Margin="0,0,8,0" VerticalAlignment="Center" Click="ChatLabelButton_Click" Visibility="Collapsed" ToolTip="管理该客户的 WhatsApp 标签" AutomationProperties.Name="管理当前会话的 WhatsApp 标签"/>
                                <Border Grid.Column="2" Background="{DynamicResource PrimarySoft}" CornerRadius="10" Padding="9,5" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatModeBadgeText" Text="CRM LIVE SYNC" Foreground="{DynamicResource PrimaryDark}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Border x:Name="ChatAgentTrack" Grid.Row="1" Visibility="Collapsed"
                                    Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,10,0,0"
                                    AutomationProperties.Name="AI 协作助手会话状态轨道">
                                <StackPanel>
                                    <WrapPanel>
                                        <Border Background="{DynamicResource PrimarySurface}" CornerRadius="7" Padding="7,3" Margin="0,0,6,4">
                                            <TextBlock x:Name="ChatAgentModeText" Text="仅建议" Foreground="{DynamicResource PrimaryDark}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border x:Name="ChatAgentRunStateBorder" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="0,0,8,4">
                                            <TextBlock x:Name="ChatAgentRunStateText" Text="可生成建议" Foreground="{DynamicResource InkSecondary}" FontSize="10.5" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                        </Border>
                                        <TextBlock x:Name="ChatAgentIdentityText" Text="AI 协作助手" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <TextBlock x:Name="ChatAgentCustomerText" Text="等待客户身份" Foreground="{DynamicResource Muted}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                    </WrapPanel>
                                    <DockPanel LastChildFill="True" Margin="0,3,0,0">
                                        <WrapPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                            <Button x:Name="StopAgentButton" Content="停止托管" Style="{StaticResource SecondaryButton}" Click="StopAgent_Click" Padding="9,4" Margin="0,0,6,0" Visibility="Collapsed" AutomationProperties.Name="停止当前会话托管"/>
                                            <Button x:Name="HeaderHumanTakeoverButton" Content="人工接管" Style="{StaticResource SecondaryButton}" Click="HumanTakeover_Click" Padding="9,4" Margin="0,0,6,0" Visibility="Collapsed" AutomationProperties.Name="人工接管当前会话"/>
                                            <Button x:Name="ViewAgentLogButton" Content="查看日志" Style="{StaticResource GhostButton}" Click="ViewAgentLog_Click" Padding="9,4" IsEnabled="False" AutomationProperties.Name="查看当前会话 AI 协作助手日志"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="ChatAgentRuntimeMetaText" Text="尚未开始运行" Foreground="{DynamicResource Muted}" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="StatusUpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WhatsApp 最新动态 · 非普通聊天消息" Foreground="{DynamicResource Warning}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="StatusUpdateLinkText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="StatusUpdateMetaText" Foreground="{DynamicResource Warning}" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开动态链接" Style="{StaticResource SecondaryButton}" Click="OpenStatusUpdate_Click" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="TranslationBar" Grid.Row="2" Visibility="Collapsed"
                            Background="{DynamicResource AiSurface}" BorderBrush="{DynamicResource AiSoft}"
                            BorderThickness="0,0,0,1" Padding="16,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                             <Border Background="{DynamicResource AiSoft}" CornerRadius="9" Padding="9,5" VerticalAlignment="Center">
                                 <TextBlock x:Name="TranslationRouteText" Text="本机语言 ⇄ 客户主流语言"
                                            Foreground="{DynamicResource AiAccentDeep}" FontSize="10.5" FontWeight="SemiBold"
                                            MaxWidth="210" TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                             </Border>
                             <TextBlock x:Name="TranslationStatusText" Grid.Column="1"
                                        Text="选择会话后自动识别；译文会缓存在本机"
                                        Foreground="{DynamicResource Muted}" FontSize="9.5"
                                        TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"
                                        AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="TranslateConversationButton" Grid.Column="2"
                                    Content="翻译最近消息" Style="{StaticResource SecondaryButton}"
                                    Click="TranslateConversation_Click" Padding="11,6"
                                    IsEnabled="False" ToolTip="把客户消息译成本机语言，并把我方消息译成客户主流语言；已缓存内容不重复消耗 Token。"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3">
                        <StackPanel x:Name="QrPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <Image x:Name="QrImage" Width="300" Height="300" Stretch="Uniform"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="WhatsApp 登录二维码"/>
                            <ProgressBar x:Name="QrProgressBar" Width="260" Height="4" Margin="36,12"
                                         IsIndeterminate="True" Visibility="Collapsed"
                                         AutomationProperties.Name="正在生成 WhatsApp 登录二维码"
                                         Foreground="{DynamicResource Primary}"/>
                            <TextBlock x:Name="QrHintText" Text="点击“连接 / 显示二维码”，然后使用手机 WhatsApp 的“已关联设备”扫描。"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}"
                                       Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <ListBox x:Name="MessageList" BorderThickness="0" Background="{DynamicResource Canvas}" Visibility="Collapsed" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="当前 WhatsApp 会话消息">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="14,6">
                                        <Border Background="{Binding BubbleBrush}" BorderBrush="{Binding BubbleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11,8" MaxWidth="520" HorizontalAlignment="{Binding Alignment}">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="回复该消息" Click="ReplyMessage_Click" Visibility="{Binding ReplyMenuVisibility}"/>
                                                    <MenuItem Header="从双方设备撤回" Click="RevokeMessage_Click" Visibility="{Binding RevokeMenuVisibility}" IsEnabled="{Binding CanRevoke}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SenderLabel}" Visibility="{Binding SenderVisibility}" Foreground="{DynamicResource PrimaryDark}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <Border Visibility="{Binding StatusUpdateVisibility}" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="6" Padding="7,4" Margin="0,0,0,6">
                                                    <TextBlock Text="WhatsApp 最新动态 · 非普通聊天消息" Foreground="{DynamicResource Warning}" FontSize="9.5" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Visibility="{Binding QuoteVisibility}" Background="{DynamicResource CanvasDeep}" BorderBrush="{DynamicResource Primary}" BorderThickness="3,0,0,0" CornerRadius="5" Padding="8,5" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding QuoteHeader}" Foreground="{DynamicResource InkSecondary}" FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding QuoteText}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" MaxWidth="450" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Visibility="{Binding ImageVisibility}" Click="OpenMedia_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Center" Cursor="Hand" ToolTip="点击用系统程序打开原图" AutomationProperties.Name="打开消息原图">
                                                    <Image Source="{Binding MediaPreview}" MaxWidth="320" MaxHeight="260" Stretch="Uniform"/>
                                                </Button>
                                                <Button Visibility="{Binding FileVisibility}" Click="OpenMedia_Click" Content="{Binding MediaActionLabel}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,7"/>
                                                <TextBlock Text="{Binding TextContent}" Visibility="{Binding TextVisibility}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" Margin="0,3,0,0"/>
                                                <Border Visibility="{Binding TranslationVisibility}"
                                                        Background="{DynamicResource AiSurface}" BorderBrush="{DynamicResource AiSoft}"
                                                        BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,7,0,1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TranslationLabel}" Foreground="{DynamicResource AiAccentDeep}"
                                                                   FontSize="8.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding TranslatedText}" Foreground="{DynamicResource Ink}"
                                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding MediaMissingText}" Visibility="{Binding MediaMissingVisibility}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" FontSize="10" Margin="0,4,0,0"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource Muted}" FontSize="9"/>
                                                    <TextBlock Text="{Binding ReceiptGlyph}" Foreground="{Binding ReceiptBrush}" FontSize="11" FontWeight="SemiBold" Margin="5,-2,0,0" ToolTip="{Binding StatusDetailLabel}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusDetailLabel}" Visibility="{Binding OutgoingStatusVisibility}" Foreground="{Binding ReceiptBrush}" FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Border Grid.Row="4" Padding="14" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="AiAssistantButton" Content="生成建议" ToolTip="按当前 Agent 模式和运行状态执行会话操作" Style="{StaticResource AiButton}" Click="AgentPrimaryAction_Click" MinWidth="104" Height="54" Padding="12,0" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Focusable="True" Margin="0,0,8,0" IsEnabled="False" AutomationProperties.Name="生成 AI 协作助手建议" AutomationProperties.HelpText="按钮会随模式和会话状态变为启用 AI、生成建议、开始协作、开始托管、托管中、已暂停、已结束、重新托管或托管异常。" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="AttachButton" Grid.Column="1" Content="＋" ToolTip="添加图片、视频、音频或文件" Style="{StaticResource SecondaryButton}" Click="Attach_Click" Width="54" Height="54" Padding="0" FontSize="25" FontWeight="SemiBold" FontFamily="Segoe UI Symbol" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Focusable="True" Margin="0,0,12,0" IsEnabled="False" AutomationProperties.Name="添加 WhatsApp 附件" AutomationProperties.HelpText="添加图片、视频、音频或文件。"/>
                             <Button x:Name="TranslateDraftButton" Grid.Column="2" Content="译成客户语言"
                                     ToolTip="按本机语言写消息，翻译成当前客户主流语言；只生成预览，不会自动发送。"
                                     Style="{StaticResource SecondaryButton}" Click="TranslateDraft_Click"
                                     MinWidth="96" Height="54" Padding="10,0" FontSize="11"
                                     Margin="0,0,12,0" IsEnabled="False"/>
                            <Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="ReplyPanel" Grid.Row="0" Background="{DynamicResource PrimarySurface}" BorderBrush="{DynamicResource Primary}" BorderThickness="3,0,0,0" CornerRadius="8" Padding="9,6" Margin="0,0,0,6" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button Content="×" DockPanel.Dock="Right" Click="ClearReply_Click" Padding="7,1" Margin="8,0,0,0" ToolTip="取消回复" AutomationProperties.Name="取消回复该消息"/>
                                        <StackPanel><TextBlock Text="回复该消息" Foreground="{DynamicResource Primary}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ReplyText" Foreground="{DynamicResource InkSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="600"/></StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="OutgoingTranslationPanel" Grid.Row="1"
                                        Background="{DynamicResource AiSurface}" BorderBrush="{DynamicResource AiAccent}"
                                        BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,0,0,6" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                         <StackPanel>
                                             <TextBlock x:Name="OutgoingTranslationLabel" Text="发送预览 · 客户语言"
                                                        Foreground="{DynamicResource AiAccentDeep}" FontSize="9" FontWeight="SemiBold"
                                                        AutomationProperties.LiveSetting="Polite"/>
                                             <ScrollViewer MaxHeight="72" Margin="0,3,8,0"
                                                           VerticalScrollBarVisibility="Auto"
                                                           HorizontalScrollBarVisibility="Disabled">
                                                 <TextBlock x:Name="OutgoingTranslationText" TextWrapping="Wrap"
                                                            AutomationProperties.LiveSetting="Polite"/>
                                             </ScrollViewer>
                                         </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="采用译文" Style="{StaticResource PrimaryButton}" Click="UseOutgoingTranslation_Click" Padding="9,4" Margin="0,0,6,0"/>
                                            <Button Content="取消" Style="{StaticResource GhostButton}" Click="CancelOutgoingTranslation_Click" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="ComposerBox" Grid.Row="2" MinHeight="54" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="False" PreviewKeyDown="ComposerBox_PreviewKeyDown" ToolTip="Enter 发送，Ctrl+Enter 换行" AutomationProperties.Name="WhatsApp 消息输入框" AutomationProperties.HelpText="Enter 发送，Ctrl+Enter 换行。"/>
                                <Border x:Name="AttachmentPanel" Grid.Row="3" Background="{DynamicResource PrimarySurface}" CornerRadius="8" Padding="8,5" Margin="0,6,0,0" Visibility="Collapsed">
                                    <DockPanel><Button Content="移除" DockPanel.Dock="Right" Click="ClearAttachment_Click" Padding="7,2" Margin="8,0,0,0"/><TextBlock x:Name="AttachmentText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
                                </Border>
                            </Grid>
                            <Button x:Name="SendButton" Grid.Column="4" Content="发送" Style="{StaticResource PrimaryButton}" Click="Send_Click" Margin="10,0,0,0" MinWidth="68" Height="54" IsEnabled="False" AutomationProperties.Name="发送当前 WhatsApp 消息"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="4">
                <Border x:Name="LeadDrawerCollapsedRail" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                    <Button Content="‹" Style="{StaticResource SecondaryButton}" Click="ToggleLeadDrawer_Click" Width="32" Height="54" Padding="0" Margin="4,14" FontSize="22" VerticalAlignment="Top" ToolTip="展开客户智能侧栏" AutomationProperties.Name="展开客户智能侧栏"/>
                </Border>
                <Border x:Name="LeadSidebarBorder" Style="{StaticResource Card}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="17,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Customer Intelligence" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="LeadLinkStateText" Text="选择会话后关联客户" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,3,0,0"/></StackPanel>
                            <Button Grid.Column="1" Content="›" Style="{StaticResource SecondaryButton}" Click="ToggleLeadDrawer_Click" Width="32" Height="32" Padding="0" FontSize="20" VerticalAlignment="Center" ToolTip="收起客户智能侧栏" AutomationProperties.Name="收起客户智能侧栏"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="AgentRoleNameText" Text="AI 协作助手" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="CustomerIdentityText" Text="等待会话身份" Foreground="{DynamicResource Muted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,3,8,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource PrimarySurface}" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                        <TextBlock x:Name="AgentModeBadgeText" Text="仅建议" Foreground="{DynamicResource PrimaryDark}" FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AgentModeCombo" DisplayMemberPath="Label" MinHeight="30" SelectionChanged="AgentModeCombo_SelectionChanged" AutomationProperties.Name="AI 协作助手模式配置" AutomationProperties.HelpText="选择模式只保存策略，不会开始托管或自动发送。"/>
                                    <Button Grid.Column="1" Content="应用" Style="{StaticResource SecondaryButton}" Click="ApplyAgentMode_Click" Padding="10,4" Margin="7,0,0,0" AutomationProperties.Name="应用 AI 协作助手模式配置"/>
                                </Grid>
                                <Border Background="{DynamicResource AiSoft}" BorderBrush="{DynamicResource AiAccent}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="AgentModeGuideTitleText" Text="仅建议：由你手动生成并确认" Foreground="{DynamicResource AiAccentDeep}" FontWeight="SemiBold" FontSize="10.5" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AgentModeTriggerText" Text="触发：点击“立即生成建议”或会话输入区的“AI”" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AgentModeOutputText" Text="产出：显示在下方，并填入输入框" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AgentModeSendText" Text="发送：绝不自动发送，由你检查后点击发送" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="选择模式后请点击“应用”。模式配置不会启动协作或托管。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="AgentStateReasonText" Text="选择客户后可设置" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AgentRuntimePanel" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,13" AutomationProperties.Name="AI 协作助手当前会话运行状态">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="会话状态轨道" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock x:Name="AgentRuntimeIdentityText" Text="AI 协作助手 · 等待客户身份" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,3,8,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <Border x:Name="AgentRunStateBadgeBorder" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="0,0,5,0">
                                            <TextBlock x:Name="AgentRunStateBadgeText" Text="未运行" Foreground="{DynamicResource InkSecondary}" FontSize="10.5" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                        </Border>
                                        <Border x:Name="AgentRiskStateBadgeBorder" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="7" Padding="7,3">
                                            <TextBlock x:Name="AgentRiskStateBadgeText" Text="无风险事项" Foreground="{DynamicResource InkSecondary}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock x:Name="AgentTopicStateText" Text="话题：等待判断" FontSize="10.5" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AgentRuntimeTimingText" Text="尚未开始运行" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <Border Background="{DynamicResource SurfaceInput}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,9,0,0">
                                    <StackPanel>
                                        <TextBlock Text="最近一次读取范围" FontWeight="SemiBold" FontSize="10.5"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <TextBlock x:Name="AgentBrainSourceText" Text="Customer Brain 0" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,0,10,3"/>
                                            <TextBlock x:Name="AgentWhatsAppSourceText" Text="WhatsApp 0" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,0,10,3"/>
                                            <TextBlock x:Name="AgentEmailSourceText" Text="邮件 0" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,0,10,3"/>
                                            <TextBlock x:Name="AgentKnowledgeSourceText" Text="知识库 0" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,0,0,3"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="AgentLatestReferencesText" Text="最近引用：未记录" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AgentPauseReasonPanel" Visibility="Collapsed" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,9,0,0">
                                    <TextBlock x:Name="AgentPauseReasonText" Text="暂停原因：未记录" Foreground="{DynamicResource Warning}" FontSize="10.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </Border>
                                <TextBlock Text="托管控制与日志入口集中在会话标题栏，避免同一操作在页面重复出现。"
                                           Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="最近一次 Agent 产出" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="AgentRunStatusText" Text="尚无产出" Foreground="{DynamicResource Primary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AgentRunTimeText" Grid.Column="1" Text="未记录" Foreground="{DynamicResource Muted}" FontSize="10.5" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock x:Name="AgentRunSourceText" Text="客户原话：等待生成" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource SurfaceInput}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,7,0,0">
                                    <TextBlock x:Name="AgentRunReplyText" Text="生成的建议回复会显示在这里。" FontSize="10" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock x:Name="AgentRunSummaryText" Text="分析摘要：未记录" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AgentRunNextActionText" Text="下一步：未记录" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AgentRunDetailText" Text="当前没有 Agent 运行结果。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="GenerateAgentSuggestionButton" Content="立即生成建议" Style="{StaticResource PrimaryButton}" Click="GenerateAgentSuggestion_Click" Padding="9,4" Margin="0,0,6,5" IsEnabled="False"/>
                                    <Button x:Name="UseAgentDraftButton" Content="填入输入框" Style="{StaticResource SecondaryButton}" Click="UseAgentDraft_Click" Padding="9,4" Margin="0,0,6,5" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock Text="仅已明确开始的“自动托管”可能直接发送；“仅建议”和“协作模式”的内容都必须由你确认。" Foreground="{DynamicResource Muted}" FontSize="10.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PrimarySurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,13" AutomationProperties.Name="商品寻源要求就绪度">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Sourcing Requirements" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="SourcingProgressText" Grid.Column="1" Text="0 / 5" Foreground="{DynamicResource Primary}" FontWeight="SemiBold"/>
                                </Grid>
                                <UniformGrid Columns="5" Margin="0,9,0,7">
                                    <TextBlock x:Name="SourcingProductText" Text="○ 商品" FontSize="9.5" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SourcingQuantityText" Text="○ 数量" FontSize="9.5" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SourcingPriceText" Text="○ 价格" FontSize="9.5" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SourcingDestinationText" Text="○ 目的地" FontSize="9.5" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SourcingLogisticsText" Text="○ 物流" FontSize="9.5" TextWrapping="Wrap"/>
                                </UniformGrid>
                                <TextBlock x:Name="SourcingStatusText" Text="Need more information" Foreground="{DynamicResource Muted}" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SourcingFieldsText" Text="缺失：产品/服务资料、范围/数量、预算/目标价格、交付地区、交付偏好" FontSize="9.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock x:Name="SourcingConflictText" Text="" Foreground="{DynamicResource Warning}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="PendingQuestionText" Text="待确认：无" Foreground="{DynamicResource Muted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Button x:Name="FindProductsButton" Content="Find Products" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Padding="10,6" HorizontalAlignment="Left" Click="FindProducts_Click" IsEnabled="False" AutomationProperties.Name="选择外部 Agent 并查找商品"/>
                                <TextBlock x:Name="SourcingActionHelpText" Text="至少收集 3 项并识别出商品后可用。" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <Border x:Name="SourcingResultPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Latest Sourcing Result" FontWeight="SemiBold" FontSize="10.5"/>
                                        <TextBlock x:Name="SourcingResultText" TextWrapping="Wrap" FontSize="9.5" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="SourcingResultBasisText" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,7,0,0">
                                            <Button Content="查看结果" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,5,5" Click="ViewSourcingResult_Click"/>
                                            <Button x:Name="AskCustomerButton" Content="Ask Customer" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,5,5" Click="AskSourcingQuestion_Click"/>
                                            <Button x:Name="RefineSearchButton" Content="Refine Search" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,5,5" Click="RefineSourcing_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border x:Name="KnowledgeReferencePanel" Background="{DynamicResource AiSoft}" BorderBrush="{DynamicResource AiAccent}" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,0,0,13" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="本次建议参考" Foreground="{DynamicResource AiAccentDeep}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="KnowledgeReferenceSummaryText" Text="尚未执行知识检索" Foreground="{DynamicResource Muted}"
                                           FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,7"/>
                                <ListBox x:Name="KnowledgeReferenceList" MaxHeight="180" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock Text="{Binding Citation}" FontWeight="SemiBold" FontSize="9.5" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Muted}" FontSize="9"
                                                           TextWrapping="Wrap" MaxHeight="42"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="查看来源" Style="{StaticResource SecondaryButton}" Click="ViewKnowledgeSource_Click" Padding="8,4" Margin="0,0,5,5"/>
                                    <Button Content="本会话排除" Style="{StaticResource SecondaryButton}" Click="ExcludeKnowledge_Click" Padding="8,4" Margin="0,0,5,5"/>
                                    <Button Content="有帮助" Style="{StaticResource SecondaryButton}" Click="HelpfulKnowledge_Click" Padding="8,4" Margin="0,0,5,5"/>
                                    <Button Content="停用来源" Style="{StaticResource DangerButton}" Click="DisableKnowledgeSource_Click" Padding="8,4" Margin="0,0,5,5"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HandoffPanel" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,13" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="需要人工处理" Foreground="{DynamicResource Warning}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="HandoffReasonText" Text="" FontSize="9.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock x:Name="HandoffOriginalText" Text="" FontSize="9.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock x:Name="HandoffTranslationText" Text="" Foreground="{DynamicResource Muted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock x:Name="HandoffPausedText" Text="" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,3,0,0"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="人工接管" Style="{StaticResource SecondaryButton}" Click="TakeOverHandoff_Click" Padding="9,4" Margin="0,0,6,0"/>
                                    <Button Content="标记解决" Style="{StaticResource SecondaryButton}" Click="ResolveHandoff_Click" Padding="9,4" Margin="0,0,6,0"/>
                                    <Button Content="复核并恢复" Style="{StaticResource PrimaryButton}" Click="ResumeAgent_Click" Padding="9,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AiCard}" Padding="13" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:ScoreRing x:Name="AiSidebarScoreRing" Width="100" Height="100" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" Margin="12,1,0,0">
                                        <TextBlock Text="AI SALES BRIEF" Style="{StaticResource PageEyebrow}"/>
                                        <TextBlock x:Name="AiSidebarBrainMetaText"
                                                   Text="CUSTOMER BRAIN · 等待客户上下文"
                                                   Foreground="{DynamicResource AiAccent}"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AiSidebarConfidenceText" Text="等待 AI 分析" FontWeight="SemiBold" Margin="0,5,0,4"/>
                                        <ProgressBar x:Name="AiSidebarConfidenceBar" Height="5" Maximum="100" Foreground="{DynamicResource AiAccent}"/>
                                        <TextBlock x:Name="AiSidebarProfileText"
                                                   Text="选择已关联客户后显示画像"
                                                   Foreground="{DynamicResource Muted}"
                                                   FontSize="9.5"
                                                   LineHeight="15"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1"
                                        Background="{DynamicResource PrimarySurface}"
                                        CornerRadius="8"
                                        Padding="9,6"
                                        Margin="0,10,0,0">
                                    <TextBlock x:Name="AiSidebarNextActionText"
                                               Text="下一步：等待客户上下文"
                                               Foreground="{DynamicResource PrimaryDark}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="客户资料" Style="{StaticResource SectionTitle}" Margin="0,0,0,11"/>
                        <TextBlock Text="姓名" Style="{StaticResource LabelText}"/><TextBox x:Name="NameBox" Margin="0,5,0,11"/>
                        <TextBlock Text="阶段" Style="{StaticResource LabelText}"/><ComboBox x:Name="StageCombo" DisplayMemberPath="Label" Margin="0,5,0,11"/>
                        <TextBlock Text="负责人" Style="{StaticResource LabelText}"/><TextBox x:Name="OwnerBox" Margin="0,5,0,11"/>
                        <CheckBox x:Name="OptInCheck" Content="客户已同意接收 WhatsApp 营销消息" Margin="0,0,0,7"/>
                        <CheckBox x:Name="OptedOutCheck" Content="客户已退订（禁止任何 Campaign）" Margin="0,0,0,11" Foreground="{DynamicResource Danger}"/>
                        <TextBlock Text="人工备注" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,5,0,11"
                                 ToolTip="仅保存销售人员手动记录，不会被最新聊天内容覆盖。"/>
                        <Border Background="{DynamicResource AiSurface}" BorderBrush="{DynamicResource AiSoft}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,0,0,11">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AI 上下文总结" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AiContextStatusText" Text="等待关联客户" Foreground="{DynamicResource AiAccent}" FontSize="9.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="RefreshAiContextButton" Grid.Column="1" Content="刷新总结" Style="{StaticResource GhostButton}"
                                            Click="RefreshAiContext_Click" Padding="10,6" IsEnabled="False"
                                            ToolTip="使用“客户列表 / Customer Brain”板块模型重新总结，会消耗 Token。"/>
                                </Grid>
                                <TextBlock x:Name="AiContextSummaryText" Text="关联客户后，将综合 WhatsApp 与邮件历史生成态度、性格、语气和当前关系摘要。"
                                           Foreground="{DynamicResource Ink}" TextWrapping="Wrap" LineHeight="17" Margin="0,9,0,0"/>
                                <TextBlock x:Name="AiContextMetaText" Text="客户原文是证据；人工备注与 AI 推断会分开标注。"
                                           Foreground="{DynamicResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="自定义维度（每行 key=value）" Style="{StaticResource LabelText}"/><TextBox x:Name="CustomFieldsBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90" Margin="0,5,0,11" FontFamily="Consolas" FontSize="11"/>
                        <Border Background="{DynamicResource WarningSoft}" CornerRadius="9" Padding="10"><TextBlock Text="保存会同步到客户列表、商机智能和后续 Campaign。" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" FontSize="10"/></Border>
                    </StackPanel></ScrollViewer>
                    <Button x:Name="SaveLeadButton" Grid.Row="2" Content="保存并同步客户" Style="{StaticResource PrimaryButton}" Click="SaveLead_Click" Margin="16" IsEnabled="False"/>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
