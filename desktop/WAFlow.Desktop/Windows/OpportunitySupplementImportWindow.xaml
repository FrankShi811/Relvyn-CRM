<Window x:Class="WAFlow.Desktop.Windows.OpportunitySupplementImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Sales OS · 商机补充数据导入" Icon="/AISalesOS;component/Assets/AI-Sales-OS.ico"
        Width="1020" Height="720" MinWidth="900" MinHeight="640"
        AutomationProperties.Name="商机补充数据导入"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="26,19">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="商机补充数据导入" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="仅匹配客户列表中完全相同的客户 ID；补充交易证据，不创建客户、不改客户主档。兼容 Buyer ID 表头。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SuccessSoft}" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="本地解析 · 预览后提交 · 可重复导入保护" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,20,26,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="选择商机补充数据工作簿" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="FilePathText" Text="尚未选择文件" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,7,18,0"/>
                    </StackPanel>
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="浏览并生成预览…"
                            Style="{StaticResource PrimaryButton}"
                            Click="Browse_Click"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="选择商机补充工作簿并生成预览"/>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Text="文件会在后台解析，预览前不会写入数据库。"
                       Foreground="{DynamicResource Muted}"
                       Margin="4,12,0,10"
                       AutomationProperties.LiveSetting="Polite"/>

            <Grid x:Name="PreviewPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="文件明细行" Style="{StaticResource LabelText}"/><TextBlock x:Name="TotalRowsText" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="四类明细合计" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="命中现有客户" Style="{StaticResource LabelText}"/><TextBlock x:Name="MatchedCustomersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Success}" Margin="0,5,0,0"/><TextBlock x:Name="MatchedEventsText" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="将丢弃 / 跳过" Style="{StaticResource LabelText}"/><TextBlock x:Name="DiscardedRowsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Warning}" Margin="0,5,0,0"/><TextBlock x:Name="DuplicateEventsText" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="将刷新商机" Style="{StaticResource LabelText}"/><TextBlock x:Name="ChangedCustomersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AiAccent}" Margin="0,5,0,0"/><TextBlock Text="只对变化客户增量分析" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Border>
                </UniformGrid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="导入契约" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"><Run Text="• "/><Run Text="仅客户 ID 完全匹配客户白名单的行进入交易事件库。"/><LineBreak/><Run Text="• "/><Run Text="成功、失败、待付款和争议交易分别去重，重复交易零写入。"/><LineBreak/><Run Text="• "/><Run Text="不使用姓名或电话兜底；不覆盖姓名、电话、邮箱、负责人、备注或锁定阶段。"/><LineBreak/><Run Text="• "/><Run Text="全部事件与客户快照在同一事务中提交，失败时整体回滚。"/></TextBlock>
                            <Border x:Name="DuplicateFileNotice" Background="{DynamicResource WarningSoft}" CornerRadius="9" Padding="12" Margin="0,15,0,0" Visibility="Collapsed">
                                <TextBlock Text="该文件已成功导入。再次确认不会写入数据，也不会触发 AI 或消耗 Token。" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="将生成的商机证据" Style="{StaticResource SectionTitle}" Margin="0,18,0,0"/>
                            <TextBlock Text="交易价值 · 近期合作意图 · 品类画像 · 支付障碍 · 纠纷风险 · 交易证据时间线" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="未匹配与冲突摘要" Style="{StaticResource SectionTitle}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <TextBlock x:Name="IssuesText" Text="无" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="26,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <ProgressBar x:Name="ProgressBar"
                                 Height="5"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 AutomationProperties.Name="商机补充数据导入进度"/>
                    <TextBlock Text="确认前不会修改客户或交易数据" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="取消商机补充数据导入"/>
                    <Button x:Name="CommitButton"
                            Content="请先生成预览"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Click="Commit_Click"
                            AutomationProperties.Name="确认商机补充数据导入"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
