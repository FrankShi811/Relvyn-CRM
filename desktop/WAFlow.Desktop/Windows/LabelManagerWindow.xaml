<Window x:Class="WAFlow.Desktop.Windows.LabelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhatsApp 标签" Width="430" Height="560" MinWidth="380" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="标签会写入 WhatsApp 自定义列表（Business 中显示为标签）；OS 仅在服务端快照确认后显示成功。" Foreground="{DynamicResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="当前标签" FontWeight="SemiBold" FontSize="12"/>
            <ItemsControl x:Name="AssignedList" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,2,6,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="×" Style="{StaticResource GhostButton}" FontSize="14" Width="32" Height="32" MinHeight="32" Padding="0" Margin="4,-5,-5,-5" Click="RemoveLabel_Click" CommandParameter="{Binding}" ToolTip="{Binding RemoveAutomationName}" AutomationProperties.Name="{Binding RemoveAutomationName}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyHint" Text="尚未添加标签" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="所有标签" FontWeight="SemiBold" FontSize="12"/>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <ItemsControl x:Name="AllLabelsList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border BorderBrush="{Binding AccentBrush}" BorderThickness="2,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" ToolTip="{Binding Id}"/>
                            </Border>
                            <Button Grid.Column="1" Content="添加" FontSize="10" Padding="8,2" Style="{StaticResource SecondaryButton}" Visibility="{Binding AddVisibility}" Click="AddLabel_Click" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AddAutomationName}"/>
                            <Button Grid.Column="2" Content="删除" FontSize="10" Padding="8,2" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="DeleteLabel_Click" CommandParameter="{Binding}" ToolTip="从 WhatsApp 删除该标签（所有客户都会失去此标签）" AutomationProperties.Name="{Binding DeleteAutomationName}"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="新建标签" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,0"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="NewLabelNameBox" Padding="8,6" FontSize="11.5" MaxLength="100" ToolTip="标签名称，例如：VIP 客户" TextChanged="NewLabelName_TextChanged" KeyDown="NewLabelName_KeyDown" AutomationProperties.Name="新标签名称"/>
                <ComboBox x:Name="NewLabelColorCombo" Grid.Column="1" Width="86" FontSize="11" Margin="6,0,0,0" SelectionChanged="NewLabelColor_SelectionChanged" AutomationProperties.Name="新标签颜色"/>
                <Button x:Name="CreateLabelButton" Content="创建" Grid.Column="2" Margin="6,0,0,0" Padding="12,6" FontSize="11" Click="CreateLabel_Click" IsEnabled="False" AutomationProperties.Name="创建并关联 WhatsApp 标签"/>
            </Grid>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{DynamicResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
