<Window x:Class="WAFlow.Desktop.Windows.ProductSourcingReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Sales OS · Send to Sourcing Agent" Icon="/AISalesOS;component/Assets/AI-Sales-OS.ico"
        Width="900" Height="780" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="25,20">
            <Grid>
                <StackPanel><TextBlock Text="HUMAN-REVIEWED AGENT ACTION" Style="{StaticResource PageEyebrow}"/><TextBlock Text="选择并核对 Sourcing Agent" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="CustomerText" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource SuccessSoft}" CornerRadius="10" Padding="10,6"><TextBlock x:Name="ReadinessText" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/></Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,20">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1 · Choose Sourcing Agent" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Relvyn 不会强制使用某个品牌或 Server。只有一个可用 Agent 时会预选，但仍需你确认。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AgentBox" DisplayMemberPath="DisplayName" SelectionChanged="ReviewInput_Changed" AutomationProperties.Name="选择 MCP Sourcing Agent"/><Button Grid.Column="1" Content="管理连接" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Padding="11,7" Click="ManageAgents_Click"/></Grid>
                        <TextBlock x:Name="AgentStatusText" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="2 · Review requirement" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="这里的编辑只用于本次 Task Override，不会悄悄覆盖 Customer Brain。若要修改正式客户事实，请回到 Customer Brain 的更新流程。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Product / 商品（必须可识别）" Style="{StaticResource LabelText}"/><TextBox x:Name="ProductBox" Margin="0,5,0,0" TextChanged="ReviewInput_Changed" AutomationProperties.Name="Task Override 商品"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Quantity / 数量" Style="{StaticResource LabelText}"/><TextBox x:Name="QuantityBox" Margin="0,5,0,0" TextChanged="ReviewInput_Changed" AutomationProperties.Name="Task Override 数量"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0"><TextBlock Text="Target Price" Style="{StaticResource LabelText}"/><TextBox x:Name="TargetPriceBox" Margin="0,5,0,0" TextChanged="ReviewInput_Changed" AutomationProperties.Name="Task Override 目标价格"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0"><TextBlock Text="Destination" Style="{StaticResource LabelText}"/><TextBox x:Name="DestinationBox" Margin="0,5,0,0" TextChanged="ReviewInput_Changed" AutomationProperties.Name="Task Override 目的地"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="7,0,0,0"><TextBlock Text="Logistics" Style="{StaticResource LabelText}"/><TextBox x:Name="LogisticsBox" Margin="0,5,0,0" TextChanged="ReviewInput_Changed" AutomationProperties.Name="Task Override 物流要求"/></StackPanel>
                        </Grid>
                        <Border x:Name="ReadinessCard" Background="{DynamicResource PrimarySoft}" CornerRadius="8" Padding="10,8" Margin="0,12,0,0"><TextBlock x:Name="ReadinessDetailText" Foreground="{DynamicResource PrimaryDark}" FontSize="9.5" TextWrapping="Wrap"/></Border>
                        <TextBlock Text="Additional Instructions（可选）" Style="{StaticResource LabelText}" Margin="0,12,0,0"/>
                        <TextBox x:Name="InstructionsBox" Margin="0,5,0,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxLength="1200" TextChanged="ReviewInput_Changed" AutomationProperties.Name="发送给 Sourcing Agent 的附加说明"/>
                        <Grid Margin="0,11,0,0"><CheckBox x:Name="ShareCustomerBox" Content="共享客户名称与当前会话标识" IsChecked="True" Checked="ReviewInput_Changed" Unchecked="ReviewInput_Changed"/><Button HorizontalAlignment="Right" Content="＋ 选择附件" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="AddAttachment_Click"/></Grid>
                        <TextBlock x:Name="AttachmentText" Text="未选择附件。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="3 · Exact task preview" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="以下内容会在点击 Send to Agent 后提交；本地文件路径和凭据不会进入 payload。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,0"/>
                        <TextBox x:Name="PreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="140" MaxHeight="240" Margin="0,10,0,0" FontFamily="Consolas" FontSize="10" AutomationProperties.Name="发送给外部 Agent 的完整预览"/>
                        <CheckBox x:Name="ConfirmBox" Content="我已核对 Agent、需求、缺失字段、共享上下文和附件，并同意本次调用" Margin="0,12,0,0" Checked="ConfirmBox_Changed" Unchecked="ConfirmBox_Changed" AutomationProperties.Name="确认发送给外部 Agent"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="25,14">
            <Grid>
                <TextBlock x:Name="StatusText" Text="外部结果会作为不可信数据展示，不会自动写入客户主档或发送给客户。" Foreground="{DynamicResource Muted}" FontSize="9.5" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button x:Name="SendButton" Content="Send to Agent" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Send_Click"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
