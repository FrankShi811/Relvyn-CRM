<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AISalesOS</AssemblyName>
    <AssemblyTitle>AI Sales OS</AssemblyTitle>
    <RootNamespace>WAFlow.Desktop</RootNamespace>
    <Version>5.19.3</Version>
    <Title>AI Sales OS</Title>
    <Product>AI Sales OS</Product>
    <Company>AI Sales OS</Company>
    <Description>AI-driven WhatsApp sales intelligence and campaign automation</Description>
    <ApplicationIcon>Assets\AI-Sales-OS.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <StartupObject>WAFlow.Desktop.App</StartupObject>
    <GitHubRepositoryUrl Condition="'$(GitHubRepositoryUrl)' == ''">https://github.com/FrankShi811/AI-whatsapp-OS</GitHubRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WAFlow.Core\WAFlow.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AI-Sales-OS.ico" />
    <Resource Include="Assets\AI-Sales-OS.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\EULA.md" Link="EULA.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\BRIDGE_GPL_COMPLIANCE.md" Link="BRIDGE_GPL_COMPLIANCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\third-party\**\*" Link="licenses\third-party\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GitHubRepositoryUrl</_Parameter1>
      <_Parameter2>$(GitHubRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
