<Window x:Class="WAFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WAFlow.Desktop.Controls"
        Title="AI Sales OS · WhatsApp 销售智能"
        Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{DynamicResource Canvas}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <controls:UiScaleHost x:Name="MainScaleHost">
    <Grid Background="{DynamicResource Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Hover-to-expand overlay navigation: the product canvas always starts at x=60. -->
        <Border x:Name="SidebarHost"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Panel.ZIndex="40"
                Width="60"
                HorizontalAlignment="Left"
                Background="{DynamicResource Sidebar}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True"
                MouseEnter="SidebarHost_MouseEnter"
                MouseLeave="SidebarHost_MouseLeave"
                PreviewMouseDown="SidebarHost_PreviewMouseDown"
                PreviewMouseUp="SidebarHost_PreviewMouseUp"
                GotKeyboardFocus="SidebarHost_GotKeyboardFocus"
                LostKeyboardFocus="SidebarHost_LostKeyboardFocus">
            <Grid Width="240" HorizontalAlignment="Left" Margin="8,14,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42"
                            Background="{DynamicResource LogoSurface}"
                            BorderBrush="{DynamicResource LogoBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="5">
                        <Image Source="/AISalesOS;component/Assets/AI-Sales-OS.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,1,0,0" VerticalAlignment="Center"
                                Tag="SidebarReveal" Opacity="0">
                        <StackPanel.RenderTransform><TranslateTransform X="-6"/></StackPanel.RenderTransform>
                        <TextBlock Text="AI Sales OS" Foreground="{DynamicResource SidebarText}" FontWeight="Bold" FontSize="16" TextWrapping="NoWrap"/>
                        <TextBlock Text="SALES INTELLIGENCE" Foreground="{DynamicResource SidebarMuted}" FontSize="8.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="COMMAND CENTER" Style="{StaticResource SidebarSectionLabel}" Margin="13,3,0,7"/>
                        <Button x:Name="DashboardButton" Tag="dashboard" Click="Navigate_Click" Style="{StaticResource NavButton}"
                                ToolTip="看板" AutomationProperties.Name="看板">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="7" Height="9" RadiusX="1" RadiusY="1" Style="{StaticResource NavIconRectangle}"/>
                                        <Rectangle Canvas.Left="14" Canvas.Top="3" Width="7" Height="5" RadiusX="1" RadiusY="1" Style="{StaticResource NavIconRectangle}"/>
                                        <Rectangle Canvas.Left="14" Canvas.Top="12" Width="7" Height="9" RadiusX="1" RadiusY="1" Style="{StaticResource NavIconRectangle}"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="16" Width="7" Height="5" RadiusX="1" RadiusY="1" Style="{StaticResource NavIconRectangle}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="看板" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="IntelligenceButton" Tag="intelligence" Click="Navigate_Click" Style="{StaticResource NavButton}"
                                ToolTip="商机智能" AutomationProperties.Name="商机智能">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z M9 13a4.5 4.5 0 0 0 3-4 M6.003 5.125A3 3 0 0 0 6.401 6.5 M3.477 10.896a4 4 0 0 1 .585-.396 M6 18a4 4 0 0 1-1.967-.516 M12 13h4 M12 18h6a2 2 0 0 1 2 2v1 M12 8h8 M16 8V5a2 2 0 0 1 2-2" Style="{StaticResource NavIconPath}"/>
                                        <Ellipse Canvas.Left="15" Canvas.Top="12" Style="{StaticResource NavIconDot}"/>
                                        <Ellipse Canvas.Left="17" Canvas.Top="2" Style="{StaticResource NavIconDot}"/>
                                        <Ellipse Canvas.Left="19" Canvas.Top="20" Style="{StaticResource NavIconDot}"/>
                                        <Ellipse Canvas.Left="19" Canvas.Top="7" Style="{StaticResource NavIconDot}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="商机智能" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="CustomersButton" Tag="customers" Click="Navigate_Click" Style="{StaticResource NavButton}"
                                ToolTip="客户列表" AutomationProperties.Name="客户列表">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M16 2v2 M17.915 22a6 6 0 0 0-12 0 M8 2v2" Style="{StaticResource NavIconPath}"/>
                                        <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Style="{StaticResource NavIconEllipse}"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="4" Width="18" Height="18" RadiusX="2" RadiusY="2" Style="{StaticResource NavIconRectangle}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="客户列表" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <TextBlock Text="CUSTOMER OPERATIONS" Style="{StaticResource SidebarSectionLabel}" Margin="13,20,0,7"/>
                        <Button x:Name="CustomerEnrichmentButton" Tag="customer-enrichment" Click="Navigate_Click" Style="{StaticResource NavButton}"
                                ToolTip="客户外部调查" AutomationProperties.Name="客户外部调查">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14" Style="{StaticResource NavIconEllipse}"/>
                                        <Path Data="M14.5 14.5L21 21 M6 10h8 M10 6c-2.2 2.4-2.2 5.6 0 8 M12 6c2.2 2.4 2.2 5.6 0 8" Style="{StaticResource NavIconPath}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="客户外部调查" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="InboxButton" Tag="inbox" Click="Navigate_Click" Style="{StaticResource NavButton}" HorizontalContentAlignment="Stretch"
                                ToolTip="WhatsApp" AutomationProperties.Name="WhatsApp">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 8V4H8 M2 14h2 M20 14h2 M15 13v2 M9 13v2" Style="{StaticResource NavIconPath}"/>
                                        <Rectangle Canvas.Left="4" Canvas.Top="8" Width="16" Height="12" RadiusX="2" RadiusY="2" Style="{StaticResource NavIconRectangle}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="WhatsApp" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                                <Border x:Name="WhatsAppUnreadBadge" Grid.Column="2" MinWidth="22" Height="20" Margin="8,0,0,0" Padding="6,0"
                                        CornerRadius="10" Background="{DynamicResource UnreadBadgeBackground}" Visibility="Collapsed"
                                        Tag="SidebarReveal" Opacity="0">
                                    <Border.RenderTransform><TranslateTransform X="-6"/></Border.RenderTransform>
                                    <TextBlock x:Name="WhatsAppUnreadText" Foreground="{DynamicResource UnreadBadgeText}" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="EmailButton" Tag="email" Click="Navigate_Click" Style="{StaticResource NavButton}" HorizontalContentAlignment="Stretch"
                                ToolTip="邮件箱" AutomationProperties.Name="邮件箱">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="20" Height="16" RadiusX="2" RadiusY="2" Style="{StaticResource NavIconRectangle}"/>
                                        <Path Data="M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" Style="{StaticResource NavIconPath}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="邮件箱" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                                <Border x:Name="EmailUnreadBadge" Grid.Column="2" MinWidth="22" Height="20" Margin="8,0,0,0" Padding="6,0"
                                        CornerRadius="10" Background="{DynamicResource UnreadBadgeBackground}" Visibility="Collapsed"
                                        Tag="SidebarReveal" Opacity="0">
                                    <Border.RenderTransform><TranslateTransform X="-6"/></Border.RenderTransform>
                                    <TextBlock x:Name="EmailUnreadText" Foreground="{DynamicResource UnreadBadgeText}" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="BroadcastButton" Tag="broadcast" Click="Navigate_Click" Style="{StaticResource NavButton}"
                                ToolTip="多渠道自动化触达" AutomationProperties.Name="多渠道自动化触达">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 11l18-5v12L3 14v-3z M11.6 16.8a3 3 0 1 1-5.8-1.6" Style="{StaticResource NavIconPath}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="自动化群发" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <TextBlock Text="INSIGHTS" Style="{StaticResource SidebarSectionLabel}" Margin="13,20,0,7"/>
                        <Button x:Name="KnowledgeButton" Tag="knowledge" Click="Navigate_Click" Style="{StaticResource NavButton}"
                                ToolTip="知识库" AutomationProperties.Name="知识库">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 7v14 M16 12h2 M16 8h2 M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z M6 12h2 M6 8h2" Style="{StaticResource NavIconPath}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="知识库" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="AnalyticsButton" Tag="analytics" Click="Navigate_Click" Style="{StaticResource NavButton}"
                                ToolTip="客户智能分析" AutomationProperties.Name="客户智能分析">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Style="{StaticResource NavIconFrame}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 3v16a2 2 0 0 0 2 2h16 M18 17V9 M13 17V5 M8 17v-3" Style="{StaticResource NavIconPath}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="客户智能分析" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource NavButton}" Margin="0,0,0,9"
                            ToolTip="设置 AI 模型、界面缩放、主题与本地体验" AutomationProperties.Name="设置">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Style="{StaticResource NavIconFrame}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.57V21h-4v-.08a1.7 1.7 0 0 0-1.03-1.57 1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.57-1.03H3v-4h.08A1.7 1.7 0 0 0 4.65 8.94a1.7 1.7 0 0 0-.34-1.88L4.25 7l2.83-2.83.06.06a1.7 1.7 0 0 0 1.88.34A1.7 1.7 0 0 0 10.05 3H10V3h4v.08a1.7 1.7 0 0 0 1.03 1.57 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06a1.7 1.7 0 0 0-.34 1.88 1.7 1.7 0 0 0 1.57 1.03H21v4h-.08A1.7 1.7 0 0 0 19.4 15z" Style="{StaticResource NavIconPath}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource NavText}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="VersionButton" Click="VersionHistory_Click" Style="{StaticResource NavButton}" Background="{DynamicResource SidebarElevated}" Margin="0,0,0,9"
                            Visibility="Collapsed"
                            ToolTip="查看版本与更新" AutomationProperties.Name="版本与更新">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SidebarUpdateIcon" Text="↻" Foreground="{DynamicResource Success}" FontSize="16" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Tag="SidebarReveal" Opacity="0">
                                <StackPanel.RenderTransform><TranslateTransform X="-6"/></StackPanel.RenderTransform>
                                <TextBlock x:Name="SidebarVersionText" Text="AI Sales OS" Foreground="{DynamicResource SidebarText}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SidebarUpdateText" Text="启动后持续监控更新" Foreground="{DynamicResource SidebarMuted}" FontSize="9.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource SidebarMuted}" FontSize="18" VerticalAlignment="Center"
                                       Tag="SidebarReveal" Opacity="0">
                                <TextBlock.RenderTransform><TranslateTransform X="-6"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Product canvas -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0,26,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TopTitle" Text="看板" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock x:Name="TopSubtitle" Text="今天最值得推进的商机与动作" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ProviderBadge" Background="{DynamicResource WarningSoft}" CornerRadius="13" Padding="11,6" Margin="0,0,9,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ProviderBadgeScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="ProviderBadgeTranslate"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Foreground="{DynamicResource AiAccent}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="ProviderText" Text="AI API 未配置" Foreground="{DynamicResource Warning}" FontSize="10.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="PageGuideButton" Content="本页使用手册" ToolTip="查看当前模块的功能介绍和操作步骤" Style="{StaticResource SecondaryButton}" Click="ShowGuide_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="ContentHost" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform><TranslateTransform x:Name="ContentHostTranslate"/></ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Global and page-specific walkthroughs -->
        <controls:GuideOverlay x:Name="OnboardingGuide" Grid.ColumnSpan="2" Panel.ZIndex="100"/>

        <!-- Keyboard-first command surface -->
        <Grid x:Name="CommandOverlay" Grid.ColumnSpan="2" Panel.ZIndex="120" Background="{DynamicResource Overlay}" Visibility="Collapsed" Opacity="0" MouseDown="CommandOverlay_MouseDown">
            <Border x:Name="CommandPanel" Width="600" VerticalAlignment="Top" Margin="0,105,0,0" Style="{StaticResource ElevatedCard}" Padding="0" Opacity="0" RenderTransformOrigin="0.5,0" MouseDown="CommandPanel_MouseDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CommandPanelScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="CommandPanelTranslate" Y="-10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,17">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource AiAccent}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="快速前往或执行操作" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="{DynamicResource CanvasDeep}" CornerRadius="5" Padding="6,2"><TextBlock Text="ESC" FontSize="9" Foreground="{DynamicResource Muted}"/></Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="10,10,10,4">
                        <TextBlock Text="建议操作" Style="{StaticResource PageEyebrow}" Margin="12,4,0,7"/>
                        <Button x:Name="FirstQuickActionButton" Tag="import" Click="QuickAction_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="＋" FontSize="18" Foreground="{DynamicResource Primary}"/><StackPanel Grid.Column="1"><TextBlock Text="导入客户数据" FontWeight="SemiBold"/><TextBlock Text="保留 Excel / CSV 原始字段" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="Enter" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Button>
                        <Button Tag="intelligence" Click="QuickAction_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="✦" FontSize="15" Foreground="{DynamicResource AiAccent}"/><StackPanel Grid.Column="1"><TextBlock Text="打开商机智能" FontWeight="SemiBold"/><TextBlock Text="查看 AI 评分证据与下一步" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Grid></Button>
                        <Button Tag="inbox" Click="QuickAction_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◉" FontSize="15" Foreground="{DynamicResource Primary}"/><StackPanel Grid.Column="1"><TextBlock Text="打开 WhatsApp" FontWeight="SemiBold"/><TextBlock Text="处理最新客户回复" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Grid></Button>
                        <Button Tag="broadcast" Click="QuickAction_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◌" FontSize="15" Foreground="{DynamicResource Warning}"/><StackPanel Grid.Column="1"><TextBlock Text="建立自动化群发任务" FontWeight="SemiBold"/><TextBlock Text="模板、受众、节奏与人工批准" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Grid></Button>
                        <Button Tag="knowledge" Click="QuickAction_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="▤" FontSize="15" Foreground="{DynamicResource Primary}"/><StackPanel Grid.Column="1"><TextBlock Text="管理业务知识与 RAG" FontWeight="SemiBold"/><TextBlock Text="上传、审核、检索测试与来源审计" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Grid></Button>
                        <Button Tag="analytics" Click="QuickAction_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◫" FontSize="15" Foreground="{DynamicResource AiAccent}"/><StackPanel Grid.Column="1"><TextBlock Text="生成客户情报报告" FontWeight="SemiBold"/><TextBlock Text="整合全部客户数据并导出 Word / PDF" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Grid></Button>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceMuted}" CornerRadius="0,0,16,16" Padding="20,11"><TextBlock Text="Ctrl+1…8 切换模块 · Ctrl+K 打开 · Esc 关闭" Foreground="{DynamicResource Muted}" FontSize="9.5"/></Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </controls:UiScaleHost>
</Window>
