<Window x:Class="WAFlow.Desktop.Windows.CampaignPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Sales OS · 个性化话术预览"
        Width="1040" Height="720" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Icon="/AISalesOS;component/Assets/AI-Sales-OS.ico"
        AutomationProperties.Name="所有客户个性化话术预览">
    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PERSONALIZED MESSAGE REVIEW" Style="{StaticResource PageEyebrow}"/>
                    <TextBlock Text="个性化话术预览" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="逐位检查所有已选客户的字段替换结果，确认后再批准发送。" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource PrimarySoft}" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource PrimaryDark}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,20,26,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="14,13,14,10">
                        <TextBlock Text="已选客户" FontSize="14" FontWeight="SemiBold"/>
                        <Label Content="搜索全部预览" Target="{Binding ElementName=SearchBox}" FontSize="12" Foreground="{DynamicResource Muted}"
                               Margin="0,7,0,0" Padding="0"/>
                        <TextBox x:Name="SearchBox" Margin="0,4,0,0" ToolTip="搜索客户、发送目标或预览内容"
                                 TextChanged="SearchBox_TextChanged" AutomationProperties.Name="搜索个性化话术预览"/>
                    </StackPanel>
                    <ListBox x:Name="PreviewList" Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource Line}"
                             SelectionChanged="PreviewList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="所有已选客户个性化话术">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="11,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Contact}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="8" Padding="7,4" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Eligible}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Eligible}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="FilterEmptyPanel" Grid.Row="1" Background="{DynamicResource Surface}" Visibility="Collapsed"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                            <TextBlock Text="没有匹配的预览" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="调整搜索词或清除搜索后重试。" Foreground="{DynamicResource Muted}" FontSize="10.5"
                                       Margin="0,5,0,11" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button Content="清除搜索" Click="ClearSearch_Click" Style="{StaticResource SecondaryButton}" MinWidth="96"
                                    AutomationProperties.Name="清除个性化话术预览搜索"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VisibleCountText" Grid.Row="2" Foreground="{DynamicResource Muted}" FontSize="10" Margin="14,9"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" DataContext="{Binding SelectedItem, ElementName=PreviewList}">
                <Grid>
                    <Grid x:Name="PreviewDetailPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CustomerMeta}" ToolTip="{Binding CustomerMeta}" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="9" Padding="9,5" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Eligible}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Eligible}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,11">
                            <TextBlock Text="{Binding EligibilityDetail}" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Grid.Row="2" Margin="18,15,18,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Visibility="{Binding EmailSubjectVisibility}" Margin="0,0,0,14">
                                <TextBlock Text="个性化邮件主题" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding Subject, Mode=OneWay}" IsReadOnly="True" Margin="0,5,0,0" AutomationProperties.Name="当前客户个性化邮件主题"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="个性化话术正文" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,5,0,0" Padding="13,11"
                                         AutomationProperties.Name="当前客户个性化话术正文"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <StackPanel x:Name="NoPreviewPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <TextBlock Text="没有可显示的预览" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="调整或清除左侧搜索词后重试。" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,13">
            <Grid>
                <TextBlock Text="可用方向键切换客户；只读文本框支持选择并复制内容。" Foreground="{DynamicResource Muted}" FontSize="10.5" VerticalAlignment="Center"/>
                <Button Content="关闭预览" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="104" IsCancel="True"
                        AutomationProperties.Name="关闭个性化话术预览"/>
            </Grid>
        </Border>
    </Grid>
</Window>
