<Window x:Class="WAFlow.Desktop.Windows.McpAgentGatewayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Sales OS · MCP 与外部智能体" Icon="/AISalesOS;component/Assets/AI-Sales-OS.ico"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="26,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="MCP AGENT GATEWAY" Style="{StaticResource PageEyebrow}"/>
                    <TextBlock Text="外部智能体连接与任务" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="Server 注册、Tool 权限、人工审批与任务记录集中在这里。断开或失败不会影响 Relvyn 本地功能。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource WarningSoft}" CornerRadius="10" Padding="10,6">
                    <TextBlock Text="默认：每次人工确认" Foreground="{DynamicResource Warning}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="16,15,16,10">
                        <TextBlock Text="MCP Servers" Style="{StaticResource SectionTitle}"/>
                        <Button HorizontalAlignment="Right" Content="＋ 添加" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="AddServer_Click" AutomationProperties.Name="添加 MCP Server"/>
                    </Grid>
                    <ListBox x:Name="ServerList" Grid.Row="1" Margin="8,0" BorderThickness="0" Background="Transparent" SelectionChanged="ServerList_SelectionChanged" AutomationProperties.Name="MCP Server 列表">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,2" CornerRadius="9" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="9.5"/>
                                        </Grid>
                                        <TextBlock Text="{Binding TransportLabel}" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="16,11,16,15">
                        <Button Content="编辑" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="EditServer_Click"/>
                        <Button Content="删除" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="8,0,0,0" Click="DeleteServer_Click"/>
                        <Button Content="导入" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="8,0,0,0" Click="ImportServer_Click"/>
                        <Button Content="导出" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="8,0,0,0" Click="ExportServer_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="18,15,18,12">
                        <StackPanel>
                            <TextBlock x:Name="SelectedServerNameText" Text="选择一个 Server" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="SelectedServerStatusText" Text="添加或选择左侧连接后查看工具。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TestButton" Content="测试连接" Style="{StaticResource SecondaryButton}" Padding="11,7" Click="TestConnection_Click"/>
                            <Button x:Name="DisconnectButton" Content="断开" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="8,0,0,0" Click="Disconnect_Click"/>
                            <Button x:Name="RefreshButton" Content="刷新工具" Style="{StaticResource PrimaryButton}" Padding="11,7" Margin="8,0,0,0" Click="RefreshTools_Click"/>
                        </StackPanel>
                    </Grid>
                    <TabControl Grid.Row="1" Margin="10,0,10,10" Background="Transparent">
                        <TabItem Header="Tools 与权限">
                            <Grid Margin="8,12,8,6">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ListView x:Name="ToolList" BorderBrush="{DynamicResource Line}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="已发现 MCP Tool 列表">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Tool" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="说明" Width="270" DisplayMemberBinding="{Binding Description}"/>
                                            <GridViewColumn Header="风险" Width="105" DisplayMemberBinding="{Binding PermissionLevel}"/>
                                            <GridViewColumn Header="批准规则" Width="110" DisplayMemberBinding="{Binding ApprovalPolicy}"/>
                                            <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding EnabledLabel}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Grid Grid.Row="1" Margin="0,11,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="选中工具：" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                        <ComboBox x:Name="PermissionBox" Width="145" Margin="6,0,0,0" AutomationProperties.Name="工具风险等级"/>
                                        <ComboBox x:Name="ApprovalBox" Width="145" Margin="8,0,0,0" AutomationProperties.Name="工具批准规则"/>
                                        <CheckBox x:Name="ToolEnabledBox" Content="启用" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="启用所选 MCP Tool"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Test Tool" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,0,8,0" Click="TestTool_Click"/>
                                        <Button Content="保存工具权限" Style="{StaticResource SecondaryButton}" Padding="11,7" Click="SaveToolPolicy_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="任务与审计">
                            <Grid Margin="8,12,8,6">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ListView x:Name="TaskList" BorderBrush="{DynamicResource Line}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="外部智能体任务列表">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="时间" Width="135" DisplayMemberBinding="{Binding CreatedLabel}"/>
                                            <GridViewColumn Header="任务" Width="220" DisplayMemberBinding="{Binding Title}"/>
                                            <GridViewColumn Header="Server / Tool" Width="190" DisplayMemberBinding="{Binding TargetLabel}"/>
                                            <GridViewColumn Header="需求版本" Width="85" DisplayMemberBinding="{Binding VersionLabel}"/>
                                            <GridViewColumn Header="状态" Width="105" DisplayMemberBinding="{Binding StatusLabel}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Button Grid.Row="1" HorizontalAlignment="Right" Content="查看任务详情" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,11,0,0" Click="ViewTask_Click"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock x:Name="StatusText" Text="凭据只保存在 Windows 凭据管理器；日志会移除 token、密钥和本地路径。" Foreground="{DynamicResource Muted}" FontSize="9.5" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <Button HorizontalAlignment="Right" Content="完成" Style="{StaticResource PrimaryButton}" Padding="15,8" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
