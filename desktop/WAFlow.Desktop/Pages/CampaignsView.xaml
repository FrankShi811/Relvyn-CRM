<UserControl x:Class="WAFlow.Desktop.Pages.CampaignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OMNICHANNEL SALES AUTOMATION" Style="{StaticResource PageEyebrow}"/>
                <TextBlock Text="多渠道自动化触达" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/>
                <TextBlock Text="统一编排 WhatsApp 与邮件任务；字段替换、受众、节奏、结果和失败原因都可追踪。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="＋  新建发送任务" Style="{StaticResource PrimaryButton}" Click="New_Click" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="发送任务" Style="{StaticResource LabelText}"/><TextBlock x:Name="CampaignCountText" Text="0" Style="{StaticResource MetricValue}" FontSize="22"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" Background="{DynamicResource PrimarySoft}" CornerRadius="9"><TextBlock Text="◌" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="运行 / 排期 / 安全停止" Style="{StaticResource LabelText}"/><TextBlock x:Name="ActiveCountText" Text="0" Style="{StaticResource MetricValue}" FontSize="22" Foreground="{DynamicResource Primary}"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" Background="{DynamicResource WarningSoft}" CornerRadius="9"><TextBlock Text="◷" Foreground="{DynamicResource Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="已发送" Style="{StaticResource LabelText}"/><TextBlock x:Name="SentCountText" Text="0" Style="{StaticResource MetricValue}" FontSize="22"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" Background="{DynamicResource SuccessSoft}" CornerRadius="9"><TextBlock Text="✓" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="6,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前渠道连接" Style="{StaticResource LabelText}"/><TextBlock x:Name="ConnectionText" Text="未连接" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" Background="{DynamicResource InfoSoft}" CornerRadius="9"><TextBlock Text="◉" Foreground="{DynamicResource Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        </Grid>

        <TabControl Grid.Row="2" x:Name="CampaignTabs">
        <TabItem Header="任务设置">
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="15,14,15,10"><TextBlock Text="发送任务" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="草稿、排期和执行记录" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                    <ListBox x:Name="CampaignList" Grid.Row="1" BorderThickness="0" SelectionChanged="CampaignList_SelectionChanged">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Padding="12,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Width="195">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ChannelLabel}" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding ScheduleLabel}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource Primary}" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="17,15,17,18">
                        <TextBlock Text="01 · 话术模板与任务设置" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="EditHintText" Text="先保存模板，选择客户并预览，再批准建立自动发送任务。" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,12"/>

                        <TextBlock Text="已保存话术模板" Style="{StaticResource LabelText}"/>
                        <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SavedTemplateBox" DisplayMemberPath="Name" SelectionChanged="SavedTemplateBox_SelectionChanged"/>
                            <Button Grid.Column="2" Content="新建" Style="{StaticResource SecondaryButton}" Click="NewTemplate_Click" Padding="10,5"/>
                            <Button Grid.Column="4" x:Name="DeleteTemplateButton" Content="删除" Style="{StaticResource DangerButton}" Click="DeleteTemplate_Click" Padding="10,5"/>
                        </Grid>
                        <TextBlock Text="模板名称" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TemplateNameBox" Margin="0,4,0,8"/>
                        <TextBlock Text="话术内容" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TemplateBox" AcceptsReturn="True" TextWrapping="Wrap" Height="105" VerticalContentAlignment="Top" Margin="0,4,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="FieldBox" DisplayMemberPath="DisplayLabel" ToolTip="只提供客户列表、商机智能和已导入表格中真实存在的字段"/>
                            <Button Grid.Column="2" Content="插入客户字段" Style="{StaticResource SecondaryButton}" Click="InsertField_Click" Padding="11,5"/>
                        </Grid>
                        <TextBlock Text="群发时会为每位客户生成独立文本；空值会替换为空，不会把字段符号直接发给客户。" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,5,0,6" TextWrapping="Wrap"/>
                        <Button x:Name="SaveTemplateButton" Content="保存话术模板" Style="{StaticResource SecondaryButton}" Click="SaveTemplate_Click" HorizontalAlignment="Left" Padding="12,6"/>

                        <StackPanel x:Name="EmailSubjectPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="邮件主题（支持同样的客户字段）" Style="{StaticResource LabelText}"/>
                            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="EmailSubjectBox"/>
                                <Button Grid.Column="2" Content="插入字段" Style="{StaticResource SecondaryButton}" Click="InsertSubjectField_Click" Padding="10,5"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,13,0,12"/>
                        <TextBlock Text="发送渠道" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="ChannelBox" DisplayMemberPath="Label" SelectionChanged="ChannelBox_SelectionChanged" Margin="0,4,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="发送账号" Style="{StaticResource LabelText}"/><ComboBox x:Name="AccountBox" DisplayMemberPath="DisplayLabel" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="任务名称" Style="{StaticResource LabelText}"/><TextBox x:Name="NameBox" Margin="0,4,0,0"/></StackPanel>
                        </Grid>

                        <TextBlock Text="02 · 任务触发方式" FontWeight="SemiBold" Margin="0,13,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ScheduleModeBox" DisplayMemberPath="Label" SelectionChanged="ScheduleModeBox_SelectionChanged"/>
                            <StackPanel x:Name="StartAtPanel" Grid.Column="2"><TextBlock Text="定时开始（北京时间）" Style="{StaticResource LabelText}"/><TextBox x:Name="StartAtBox" ToolTip="例如 2026-07-20 18:30" Margin="0,4,0,0"/></StackPanel>
                        </Grid>

                        <TextBlock Text="03 · 逐条发送节奏" FontWeight="SemiBold" Margin="0,13,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="每隔" Style="{StaticResource LabelText}"/><TextBox x:Name="IntervalBox" Margin="0,4,0,0"/></StackPanel>
                            <ComboBox Grid.Column="2" x:Name="IntervalUnitBox" DisplayMemberPath="Label" VerticalAlignment="Bottom"/>
                            <StackPanel Grid.Column="4"><TextBlock Text="每日上限" Style="{StaticResource LabelText}"/><TextBox x:Name="DailyLimitBox" Margin="0,4,0,0"/></StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource WarningSoft}" CornerRadius="8" Padding="10" Margin="0,12,0,11">
                            <TextBlock x:Name="SafetyHintText" Text="WhatsApp 任务会记录公网 IP 并持续核对；IP 变化立即停止自动触达。邮件任务以 SMTP 服务器接受结果计为成功，失败原因单独记录。" Foreground="{DynamicResource Warning}" FontSize="9" TextWrapping="Wrap"/>
                        </Border>

                        <WrapPanel>
                            <Button x:Name="SaveButton" Content="保存任务草稿" Style="{StaticResource SecondaryButton}" Click="Save_Click" Margin="0,0,7,7"/>
                            <Button x:Name="PreviewButton" Content="预览个性化话术" Style="{StaticResource SecondaryButton}" Click="Preview_Click" Margin="0,0,7,7"
                                    AutomationProperties.Name="预览所有已选客户的个性化话术"
                                    AutomationProperties.HelpText="打开集中预览窗口，逐位检查所有已选客户的字段替换结果。"/>
                            <Button x:Name="ApproveButton" Content="批准并建立任务" Style="{StaticResource PrimaryButton}" Click="Approve_Click" Margin="0,0,7,7"/>
                            <Button x:Name="PauseResumeButton" Content="暂停" Style="{StaticResource SecondaryButton}" Click="PauseResume_Click" Margin="0,0,7,7" IsEnabled="False"/>
                            <Button x:Name="CancelButton" Content="取消任务" Style="{StaticResource DangerButton}" Click="Cancel_Click" Margin="0,0,0,7" IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="15,13,15,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="04 · 选择发送客户" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="PreviewSummaryText" Text="请勾选一位或多位客户" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                            <TextBlock Grid.Column="1" x:Name="EligibleCountText" Text="已选 0" Foreground="{DynamicResource Primary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="AudienceSearchBox" Margin="0,9,0,7" ToolTip="搜索姓名、公司、WhatsApp、邮箱或标签" TextChanged="AudienceFilter_Changed"/>
                        <Grid x:Name="AudienceFilterActionsRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CustomerGradeFilterBox"
                                      AutomationProperties.Name="发送客户等级筛选"
                                      SelectionChanged="AudienceFilter_Changed"/>
                            <ComboBox Grid.Column="2"
                                      x:Name="CustomerStageFilterBox"
                                      AutomationProperties.Name="发送客户阶段筛选"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="AudienceFilter_Changed"/>
                            <ComboBox Grid.Column="4"
                                      x:Name="CustomerCategoryPreferenceFilterBox"
                                      AutomationProperties.Name="发送客户一级品类偏好筛选"
                                      DisplayMemberPath="Label"
                                      ToolTip="按一级品类偏好筛选发送客户"
                                      SelectionChanged="AudienceFilter_Changed"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="全选当前可发送" Style="{StaticResource SecondaryButton}" Click="SelectAllEligible_Click" Padding="10,5" MinHeight="32" Margin="0,0,6,0"/>
                                <Button Content="清空选择" Style="{StaticResource SecondaryButton}" Click="ClearSelection_Click" Padding="10,5" MinHeight="32"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="AudienceGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" BorderThickness="0,1,0,1"
                              AutomationProperties.Name="发送客户列表">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选" Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="AudienceCheck_Click" IsEnabled="{Binding Eligible}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="客户" Binding="{Binding DisplayName}" Width="1.05*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="发送目标" Binding="{Binding Contact}" Width="1.15*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="一级品类偏好" Binding="{Binding PrimaryCategoryPreference}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding Grade}" Width="48" IsReadOnly="True"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="75" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceMuted}" Padding="12" CornerRadius="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="任务状态" Style="{StaticResource LabelText}"/>
                            <TextBlock x:Name="CampaignStateText" Text="新草稿" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="PauseReasonText" Text="" Foreground="{DynamicResource Warning}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </TabItem>
        <TabItem Header="发送历史与质量">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource PrimarySurface}" Padding="15,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0">
                        <StackPanel><TextBlock Text="任务发送历史" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="按 WhatsApp / 邮件渠道分别统计成功、失败、跳过、完成进度与失败原因。" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="42" MouseDoubleClick="HistoryGrid_MouseDoubleClick" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="渠道" Binding="{Binding Channel}" Width="82"/>
                            <DataGridTextColumn Header="账号" Binding="{Binding AccountId}" Width="105"/>
                            <DataGridTextColumn Header="触发时间" Binding="{Binding Trigger}" Width="135"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="92"/>
                            <DataGridTextColumn Header="总数" Binding="{Binding Total}" Width="58"/>
                            <DataGridTextColumn Header="成功" Binding="{Binding Sent}" Width="58"/>
                            <DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="58"/>
                            <DataGridTextColumn Header="跳过" Binding="{Binding Skipped}" Width="58"/>
                            <DataGridTextColumn Header="取消" Binding="{Binding Cancelled}" Width="58"/>
                            <DataGridTextColumn Header="待发送" Binding="{Binding Queued}" Width="68"/>
                            <DataGridTextColumn Header="完成进度" Binding="{Binding Progress}" Width="82"/>
                            <DataGridTextColumn Header="发送成功率" Binding="{Binding SuccessRate}" Width="88"/>
                            <DataGridTextColumn Header="停止 / 下一位置" Binding="{Binding StopOrNext}" Width="210"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding Detail}" Width="280"/>
                            <DataGridTextColumn Header="最后更新" Binding="{Binding Updated}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </TabItem>
        </TabControl>
    </Grid>
</UserControl>
