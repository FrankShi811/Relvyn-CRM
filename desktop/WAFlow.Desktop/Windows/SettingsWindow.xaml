<Window x:Class="WAFlow.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WAFlow.Desktop.Controls"
        Title="AI Sales OS · 设置" Icon="/AISalesOS;component/Assets/AI-Sales-OS.ico"
        Width="980" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <controls:UiScaleHost x:Name="SettingsScaleHost">
    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="SYSTEM CONFIGURATION" Style="{StaticResource PageEyebrow}"/><TextBlock x:Name="SettingsTitleText" Text="设置" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="SettingsSubtitleText" Text="统一管理公司与工作角色、AI Provider、板块模型、界面缩放、主题与本地数据体验。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="本页使用手册" ToolTip="查看设置的功能介绍和操作步骤" Style="{StaticResource SecondaryButton}" Click="ShowGuide_Click" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,28">
                <Border Style="{StaticResource Card}" AutomationProperties.Name="公司与 AI 工作角色设置">
                    <StackPanel>
                        <TextBlock Text="公司与 AI 工作角色" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="让各个 AI 板块理解你服务的公司、产品或服务以及岗位重点。不填写也能使用，系统会保持通用销售语境。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="公司或团队名称（可选）" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="BusinessOrganizationNameBox" MaxLength="120" Margin="0,5,0,0" AutomationProperties.Name="公司或团队名称"/>
                                <TextBlock Text="留空时不会在 AI 内容中假设公司名称。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="你的主要角色" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="BusinessRoleBox" IsEditable="True" IsTextSearchEnabled="True" Margin="0,5,0,0" SelectionChanged="BusinessRoleBox_SelectionChanged" AutomationProperties.Name="主要工作角色"/>
                                <TextBlock Text="可选择常用角色，也可以直接输入自己的岗位。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="公司业务（推荐）" Style="{StaticResource LabelText}" Margin="0,13,0,0"/>
                        <TextBox x:Name="BusinessDescriptionBox" MaxLength="800" MinHeight="58" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" AutomationProperties.Name="公司业务描述"/>
                        <TextBlock Text="简要说明提供什么产品或服务、主要客户和市场。不要填写客户隐私、账号密码或内部机密。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="角色 Skill 描述" Style="{StaticResource LabelText}" Margin="0,13,0,0"/>
                        <TextBox x:Name="RoleSkillDescriptionBox" MaxLength="1200" MinHeight="70" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" AutomationProperties.Name="角色 Skill 描述"/>
                        <TextBlock Text="说明你希望 AI 协助完成的职责、判断重点和人工确认边界。该描述会进入商机智能、Customer Brain、客户分析、WhatsApp、邮件和触达内容的共同上下文。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource PrimarySoft}" CornerRadius="9" Padding="11" Margin="0,12,0,0">
                            <TextBlock Text="此设置只影响新生成内容的业务语境，不修改客户资料、历史消息或既有报告，也不能覆盖证据、安全规则和人工确认要求。" Foreground="{DynamicResource PrimaryDark}" FontSize="9.5" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AiCard}" Margin="0,15,0,0">
                    <StackPanel>
                        <Grid><StackPanel><TextBlock Text="AI Provider" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择主流 Provider，自动带入默认 Base URL，再拉取该 Key 可用的真实模型。" Style="{StaticResource LabelText}" Margin="0,3,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="{DynamicResource SuccessSoft}" CornerRadius="10" Padding="9,5"><TextBlock x:Name="ApiStatusText" Text="未配置" Foreground="{DynamicResource Success}" FontSize="10.5" FontWeight="SemiBold"/></Border></Grid>
                        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource AiSoft}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="AI 服务商" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="AiProviderBox" DisplayMemberPath="DisplayName" Margin="0,5,0,0" SelectionChanged="AiProviderBox_SelectionChanged"/>
                                <TextBlock x:Name="ProviderDescriptionText" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                <TextBlock Text="API Key" Style="{StaticResource LabelText}"/><PasswordBox x:Name="ApiKeyBox" Margin="0,5,0,0" PasswordChanged="ProviderInput_Changed"/>
                                <TextBlock Text="留空会保留当前服务商已保存的 Key；每个 Provider 独立写入 Windows 凭据管理器。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,0"/>
                                <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Base URL" Style="{StaticResource LabelText}"/><TextBox x:Name="BaseUrlBox" Text="https://api.deepseek.com" Margin="0,5,0,0" TextChanged="ProviderInput_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="全域默认模型" Style="{StaticResource LabelText}"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ModelBox" IsEditable="False" IsTextSearchEnabled="True" MinWidth="180" ToolTip="从 Provider 的 /models 接口自动拉取" SelectionChanged="ModelBox_SelectionChanged"/><Button x:Name="ReloadModelsButton" Grid.Column="1" Content="↻ 拉取" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="8,0,0,0" Click="ReloadModels_Click"/></Grid></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="全域推理深度" Style="{StaticResource LabelText}"/><ComboBox x:Name="ReasoningEffortBox" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,5,0,0" ToolTip="只展示 API 元数据或官方模型规格确认支持的档位"/></StackPanel>
                                </Grid>
                                <TextBlock x:Name="ModelStatusText" Text="填写 API Key 后将自动拉取可用模型。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ReasoningStatusText" Text="推理档位以 API 模型目录返回的能力元数据为准；未声明时使用模型默认值，不发送未知参数。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource WarningSoft}" CornerRadius="9" Padding="11" Margin="0,12,0,0"><TextBlock Text="AI 分析只在结构校验成功后更新商机分数与看板；失败客户继续保持 D / 0 并进入重试。" Foreground="{DynamicResource Warning}" FontSize="9.5" TextWrapping="Wrap"/></Border>
                        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="已配置的 AI 服务" Style="{StaticResource LabelText}"/>
                                <ItemsControl x:Name="ConfiguredProvidersItems" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ModelLabel}" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{DynamicResource Success}" FontSize="9.5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoConfiguredProvidersText" Text="尚未配置 Provider。填写并验证 API Key 后会显示在这里。" Foreground="{DynamicResource Muted}" FontSize="9.5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="EnrichmentSettingsSection" Style="{StaticResource Card}" Margin="0,15,0,0"
                        AutomationProperties.Name="客户外部调查设置">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="客户外部调查" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="先任选一个搜索密钥用于收集公开来源。若要把来源整理成 Customer Brain 可用事实，再开启下方 AI 事实整理并设置本程序的月度估算提醒额度。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,5,20,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SuccessSoft}" CornerRadius="10" Padding="10,5" VerticalAlignment="Top">
                                <TextBlock x:Name="EnrichmentProviderStatusText" Text="正在读取" Foreground="{DynamicResource Success}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource PrimarySoft}" BorderBrush="{DynamicResource Primary}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,13,0,0">
                            <TextBlock Text="第一步（必需）：从 Tavily 或 Brave Search 获取对应密钥，任选一个粘贴后保存。这样即可收集并查看公开来源，连接测试不是必需步骤。" Foreground="{DynamicResource PrimaryDark}" FontSize="10" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Tavily 搜索密钥（推荐）" Style="{StaticResource LabelText}"/>
                                <PasswordBox x:Name="TavilySearchKeyBox" Margin="0,5,0,0" AutomationProperties.Name="Tavily 搜索密钥"/>
                                <TextBlock x:Name="TavilySearchStatusText" Text="留空会保留已保存 Key" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Tag="tavily" Content="测试连接" Style="{StaticResource SecondaryButton}" Padding="12,7" VerticalAlignment="Center" Click="SearchProviderTest_Click" AutomationProperties.Name="测试 Tavily 搜索连接"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Brave Search 密钥（备选）" Style="{StaticResource LabelText}"/>
                                <PasswordBox x:Name="BraveSearchKeyBox" Margin="0,5,0,0" AutomationProperties.Name="Brave Search 密钥"/>
                                <TextBlock x:Name="BraveSearchStatusText" Text="留空会保留已保存 Key" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Tag="brave" Content="测试连接" Style="{StaticResource SecondaryButton}" Padding="12,7" VerticalAlignment="Center" Click="SearchProviderTest_Click" AutomationProperties.Name="测试 Brave Search 连接"/>
                        </Grid>

                        <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                            <StackPanel>
                                <TextBlock Text="第二步（需要进入 Customer Brain 时）" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="AI 会把公开来源整理成可审核事实，并可能产生 Provider 费用。勾选启用并填写正数提醒额度后，本程序会按本地估算累计并在达到额度时停止新调用；这不是 Provider 账单上限。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,9" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="EnrichmentAllowAiAnalysisBox" Content="启用 AI 事实整理（可能产生费用）" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.Name="启用 AI 整理公开来源为客户事实并接受可能产生 Provider 费用"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="本地月度估算提醒额度 USD" Style="{StaticResource LabelText}"/>
                                        <TextBox x:Name="EnrichmentBudgetBox" Text="0" Margin="0,5,0,0" AutomationProperties.Name="客户调查本程序本地月度估算提醒额度美元"/>
                                    </StackPanel>
                                    <TextBlock x:Name="EnrichmentAiStatusText" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="9.5" TextWrapping="Wrap" Text="正在读取板块 AI 路由状态…"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource WarningSoft}" CornerRadius="9" Padding="11" Margin="0,12,0,0">
                            <TextBlock Text="安全默认值：本地月度估算提醒额度为 0 美元，付费搜索与 AI 事实整理均关闭。只收集来源不会进入 Customer Brain；开启 AI 后仍须人工审核，且不会自动覆盖客户主档。程序只统计本机调用，Provider 账号在其他工具中的用量不可见，实际账单以 Provider 为准。" Foreground="{DynamicResource Warning}" FontSize="9.5" TextWrapping="Wrap"/>
                        </Border>

                        <Expander Header="高级选项（通常无需修改）" IsExpanded="False" Margin="0,13,0,0"
                                  AutomationProperties.Name="客户外部调查高级选项">
                            <StackPanel Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="检索切换顺序" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="EnrichmentProviderOrderBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="客户外部调查检索 Provider 切换顺序"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0"><TextBlock Text="Tavily 每月账号额度估算" Style="{StaticResource LabelText}"/><TextBox x:Name="TavilyFreeRequestsBox" Text="1000" Margin="0,5,0,0" AutomationProperties.Name="Tavily 每月账号额度本地估算"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Brave 每月账号额度估算" Style="{StaticResource LabelText}"/><TextBox x:Name="BraveFreeRequestsBox" Text="1000" Margin="0,5,0,0" AutomationProperties.Name="Brave 每月账号额度本地估算"/></StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="每次 AI 本地估算预留 USD" Style="{StaticResource LabelText}"/>
                                        <TextBox x:Name="EnrichmentAiReservationBox" Text="0.05" Margin="0,5,0,0" AutomationProperties.Name="客户调查每次 AI 事实整理本地估算预留美元"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EnrichmentAllowPaidBox" Grid.Column="1" Content="账号额度估算用尽后，允许本程序继续付费搜索" VerticalAlignment="Center" AutomationProperties.Name="允许客户调查在本地账号额度估算用尽后继续付费搜索"/>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SearXngEnabledBox" Content="启用本机搜索服务" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.Name="启用本机搜索服务"/>
                                        <TextBox x:Name="SearXngBaseUrlBox" Grid.Column="1" Margin="16,0,12,0" Text="http://127.0.0.1:8080" AutomationProperties.Name="本机搜索服务地址"/>
                                        <Button Grid.Column="2" Tag="searxng" Content="测试本机服务" Style="{StaticResource SecondaryButton}" Padding="12,7" Click="SearchProviderTest_Click" AutomationProperties.Name="测试本机搜索服务"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0"><TextBlock Text="每客查询" Style="{StaticResource LabelText}"/><TextBox x:Name="EnrichmentMaxQueriesBox" Text="6" Margin="0,5,0,0" AutomationProperties.Name="每位客户最大查询数"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0"><TextBlock Text="每条结果" Style="{StaticResource LabelText}"/><TextBox x:Name="EnrichmentMaxResultsBox" Text="8" Margin="0,5,0,0" AutomationProperties.Name="每条查询最大结果数"/></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="7,0"><TextBlock Text="读取网页" Style="{StaticResource LabelText}"/><TextBox x:Name="EnrichmentMaxPagesBox" Text="12" Margin="0,5,0,0" AutomationProperties.Name="每位客户最大网页读取数"/></StackPanel>
                                    <StackPanel Grid.Column="3" Margin="7,0"><TextBlock Text="缓存天数" Style="{StaticResource LabelText}"/><TextBox x:Name="EnrichmentCacheDaysBox" Text="30" Margin="0,5,0,0" AutomationProperties.Name="客户调查缓存天数"/></StackPanel>
                                    <StackPanel Grid.Column="4" Margin="7,0,0,0"><TextBlock Text="标准刷新" Style="{StaticResource LabelText}"/><TextBox x:Name="EnrichmentRefreshDaysBox" Text="90" Margin="0,5,0,0" AutomationProperties.Name="客户调查标准刷新天数"/></StackPanel>
                                    <StackPanel Grid.Column="5" Margin="7,0,0,0"><TextBlock Text="数据保留" Style="{StaticResource LabelText}"/><TextBox x:Name="EnrichmentRetentionDaysBox" Text="730" Margin="0,5,0,0" AutomationProperties.Name="客户调查数据保留天数"/></StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,13,0,0">
                                    <CheckBox x:Name="EnrichmentManualEnabledBox" Content="允许手动调查" IsChecked="True" Margin="0,0,22,0" AutomationProperties.Name="允许手动客户调查"/>
                                    <CheckBox x:Name="EnrichmentAutoGradeABox" Content="A级客户自动入队" IsChecked="True" Margin="0,0,22,0" AutomationProperties.Name="A级客户自动调查"/>
                                    <CheckBox x:Name="EnrichmentAutoGradeBBox" Content="B级客户自动入队" IsChecked="True" Margin="0,0,22,0" AutomationProperties.Name="B级客户自动调查"/>
                                </WrapPanel>
                                <Border Background="{DynamicResource WarningSoft}" CornerRadius="9" Padding="11" Margin="0,12,0,0">
                                    <TextBlock Text="账号额度估算用尽时会自动切换下一种可用搜索方式或停止。连接测试会真实联网并可能计入 Provider 用量；这里的额度、单价和预留都只是本程序本地估算，只统计本机调用，不含账号在其他工具中的用量，实际额度与账单始终以 Provider 为准。" Foreground="{DynamicResource Warning}" FontSize="9.5" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="EnrichmentUsageText" Text="本月用量：正在读取" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EnrichmentConnectionStatusText" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,15,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="板块模型与 Token 成本" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="默认所有功能继承全域模型；关闭统一模式后，可为 Command Center、Customer Operations 与 Insights 的每个板块单独选择。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,5,20,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="UseGlobalAiConfigurationBox" Grid.Column="1" Content="所有板块使用同一模型" FontWeight="SemiBold" VerticalAlignment="Center" Checked="UseGlobalAiConfiguration_Changed" Unchecked="UseGlobalAiConfiguration_Changed"/>
                        </Grid>
                        <Border Background="{DynamicResource PrimarySoft}" CornerRadius="9" Padding="11" Margin="0,13,0,0">
                            <TextBlock x:Name="AiRoutingSummaryText" Text="当前所有板块继承全域默认模型与推理深度。" Foreground="{DynamicResource PrimaryDark}" FontSize="9.5" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel x:Name="ModuleRoutingPanel" Margin="0,13,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="板块与实际 AI 用途" Style="{StaticResource LabelText}"/>
                                <TextBlock Grid.Column="1" Text="Provider" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="模型" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="推理深度" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                            </Grid>
                            <ItemsControl x:Name="ModuleRoutingItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalAlignment="Center" SelectionChanged="ModuleProviderBox_SelectionChanged"/>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalAlignment="Center" IsTextSearchEnabled="True" SelectionChanged="ModuleModelBox_SelectionChanged"/>
                                                <ComboBox Grid.Column="3" ItemsSource="{Binding ReasoningOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReasoningEffort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="说明：邮件箱的收发同步、普通群发和知识检索本身不调用模型；只有界面标注的生成、分析或图片 OCR 操作才消耗 Token。API 未声明某模型支持的推理档位时，系统只允许“自动”，不会猜测并误发 low / ultra 参数。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,15,0,0" AutomationProperties.Name="MCP 与外部智能体设置">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Background="{DynamicResource AiSoft}" CornerRadius="10" VerticalAlignment="Top">
                            <TextBlock Text="↗" Foreground="{DynamicResource Ai}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <TextBlock Text="MCP 与外部智能体" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="连接可审计的外部 MCP Server，并为每个 Tool 单独设置权限。达到 3/5 且商品可识别时，只显示人工调用入口；系统不会自动把客户信息发给第三方。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <CheckBox x:Name="McpGatewayEnabledBox" Content="在 Windows 桌面端启用 MCP Agent Gateway" Margin="0,12,0,0" AutomationProperties.Name="启用 MCP 外部智能体接入层"/>
                            <TextBlock x:Name="McpConnectionSummaryText" Text="正在读取 MCP 连接配置…" Foreground="{DynamicResource Info}" FontSize="10" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="发送前仍需选择 Server / Tool、核对字段、附件和共享上下文并人工确认。第三方 Agent 永远不能直接向 WhatsApp、邮件或短信客户发消息。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="配置 MCP 连接" Style="{StaticResource SecondaryButton}" Padding="13,8" VerticalAlignment="Top" Click="ManageMcpAgents_Click" AutomationProperties.Name="配置 MCP Server、Tool、权限与任务"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,15,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="外观与可读性" Style="{StaticResource SectionTitle}"/><TextBlock Text="主题和缩放会应用到整个主界面；缩小可在低分辨率下展示更多内容，放大可提升文字和控件可读性。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="主题模式" Style="{StaticResource LabelText}"/><ComboBox x:Name="ThemeModeBox" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="界面缩放" Style="{StaticResource LabelText}"/><ComboBox x:Name="UiScaleBox" DisplayMemberPath="Label" Margin="0,5,0,0" SelectionChanged="UiScaleBox_SelectionChanged" ToolTip="80% / 90% 适合低分辨率；110% / 125% 适合需要更大文字的屏幕"/></StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,15,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Background="{DynamicResource PrimarySoft}" CornerRadius="10" VerticalAlignment="Top">
                            <TextBlock Text="▣" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="本地数据工作区" Style="{StaticResource SectionTitle}"/>
                                <Border Background="{DynamicResource SuccessSoft}" CornerRadius="9" Padding="8,3" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="当前工作区" Foreground="{DynamicResource Success}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DatabasePathText" Foreground="{DynamicResource Ink}" FontSize="10.5" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WorkspaceUsageText" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,0" TextWrapping="Wrap" Text="正在统计工作区占用和磁盘空间…"/>
                            <TextBlock Text="迁移范围包括客户与 AI 结果、WhatsApp 加密会话与媒体、邮件索引、知识库原件、自动化和报告。API Key 与邮箱密码仍由 Windows 凭据管理器保护。" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource WarningSoft}" CornerRadius="8" Padding="9,7" Margin="0,9,0,0">
                                <TextBlock x:Name="WorkspaceStatusText" Text="迁移会先复制并校验，重启成功后才切换；校验失败会继续使用原位置。" Foreground="{DynamicResource Warning}" FontSize="9.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="OpenWorkspaceButton" Content="打开位置" Style="{StaticResource SecondaryButton}" Padding="12,7" Click="OpenWorkspace_Click" Margin="0,0,8,0"/>
                            <Button x:Name="MoveWorkspaceButton" Content="迁移工作区" Style="{StaticResource PrimaryButton}" Padding="12,7" Click="MoveWorkspace_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,15">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="版本与更新" Style="{StaticResource SecondaryButton}" Click="VersionHistory_Click" Padding="12,7" MinHeight="34" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SettingsStatusText" Text="尚未保存的更改不会应用" Foreground="{DynamicResource Muted}" FontSize="9.5" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="放弃更改" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <controls:GuideOverlay x:Name="SettingsGuide" Grid.RowSpan="3" Panel.ZIndex="100"/>
    </Grid>
    </controls:UiScaleHost>
</Window>
