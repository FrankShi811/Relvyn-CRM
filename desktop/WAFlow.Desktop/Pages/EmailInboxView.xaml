<UserControl x:Class="WAFlow.Desktop.Pages.EmailInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WAFlow.Desktop.Controls"
             AutomationProperties.Name="邮件箱">
    <Grid Margin="30,24,30,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="17"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CUSTOMER EMAIL INTELLIGENCE" Style="{StaticResource PageEyebrow}"/>
                <TextBlock Text="邮件箱" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/>
                <TextBlock Text="连接邮箱、收发邮件、保存历史，并通过邮箱地址与客户列表和商机智能共享同一客户资料。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <WrapPanel HorizontalAlignment="Right">
                    <ComboBox x:Name="AccountBox" Width="235" DisplayMemberPath="DisplayLabel" SelectionChanged="AccountBox_SelectionChanged" Margin="0,0,8,0"/>
                    <Button Content="＋ 连接邮箱" Style="{StaticResource SecondaryButton}" Click="AddAccount_Click" Margin="0,0,8,0"/>
                    <Button Content="管理账号" Style="{StaticResource SecondaryButton}" Click="ManageAccount_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SyncButton" Content="同步收件箱" Style="{StaticResource PrimaryButton}" Click="Sync_Click"/>
                </WrapPanel>
                <TextBlock x:Name="EmailSyncStatusText" Text="" Foreground="{DynamicResource Muted}" FontSize="10"
                           TextAlignment="Right" TextWrapping="Wrap" MaxWidth="620" Margin="0,6,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="CustomerDrawerColumn" Width="380"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="16,15,16,12">
                    <TextBlock Text="邮件会话" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="搜索姓名、邮箱、主题或正文"/>
                        <Button Grid.Column="2" x:Name="NewEmailButton" Content="＋" Style="{StaticResource SecondaryButton}"
                                Width="46" Padding="0" FontSize="20" Click="NewEmail_Click"
                                ToolTip="新建邮件" AutomationProperties.Name="新建邮件"/>
                    </Grid>
                </StackPanel>
                <ListBox x:Name="ConversationList" Grid.Row="1" BorderThickness="0" SelectionChanged="ConversationList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Padding="14,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Width="260">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnreadVisibility}" Value="Visible">
                                            <Setter Property="Background" Value="{DynamicResource PrimarySoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnreadVisibility}" Value="Visible">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryDark}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding LastTimeLabel}" Foreground="{DynamicResource Muted}" FontSize="9"/>
                                <TextBlock Grid.Row="1" Text="{Binding PeerEmail}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,2,8,0" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Primary}" CornerRadius="9"
                                        MinWidth="18" Height="18" Padding="5,0" Visibility="{Binding UnreadVisibility}">
                                    <TextBlock Text="{Binding UnreadLabel}" Foreground="{DynamicResource SidebarText}" FontSize="10"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding LastMessage}" Foreground="{DynamicResource Muted}"
                                           FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid></Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Padding="18,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><StackPanel><TextBlock x:Name="ConversationTitle" Text="选择邮件会话" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="ConversationSubtitle" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel></Border>
                <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceMuted}"><ItemsControl x:Name="MessageList" Margin="14"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border x:Name="Bubble" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,5" MaxWidth="640">
                        <Border.Style><Style TargetType="Border"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><DataTrigger Binding="{Binding DirectionLabel}" Value="已发送"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding TextBody}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding VisibleInlineImages}" Margin="0,6,0,0" Visibility="{Binding HasInlineImages}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,3">
                                        <StackPanel>
                                            <Image Source="{Binding LocalPath}" MaxHeight="260" Stretch="Uniform" ToolTip="{Binding FileName}"/>
                                            <TextBlock Text="{Binding FileName}" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding VisibleAttachments}" Margin="0,8,0,0" Visibility="{Binding HasVisibleAttachments}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,3">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="📎" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Text="{Binding SizeLabel}" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel>
                                            <Button Grid.Column="2" Content="下载" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Click="AttachmentDownload_Click" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding HtmlLinks}" Margin="0,6,0,0" Visibility="{Binding HasHtmlLinks}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="🔗" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Hyperlink Click="HtmlLink_Click" CommandParameter="{Binding Url}" ToolTip="{Binding Url}"><Run Text="{Binding Text}"/></Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="查看原格式（表格/按钮/链接）" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="{Binding HasHtmlBody}" Click="HtmlPreview_Click" CommandParameter="{Binding}"/>
                            <TextBlock Text="{Binding DirectionLabel}" Foreground="{DynamicResource Muted}" FontSize="9" HorizontalAlignment="Right" Margin="0,7,0,0"/><TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource Muted}" FontSize="9" HorizontalAlignment="Right"/></StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <Border Grid.Row="2" Padding="15" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><StackPanel>
                    <TextBox x:Name="RecipientBox" ToolTip="收件邮箱" Margin="0,0,0,7" IsReadOnly="True"
                             TextChanged="RecipientBox_TextChanged" LostFocus="RecipientBox_LostFocus"/>
                    <TextBox x:Name="SubjectBox" ToolTip="邮件主题" Margin="0,0,0,7"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="ComposerAiButton" Content="✦ AI 写信" Style="{StaticResource SecondaryButton}" Click="GenerateEmailDraft_Click"
                                VerticalAlignment="Stretch" Padding="11,5" IsEnabled="False" ToolTip="根据客户资料、邮件上下文和你的写信意图生成草稿"/>
                        <TextBox Grid.Column="2" x:Name="ComposerBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" ToolTip="邮件正文"/>
                        <Button Grid.Column="4" x:Name="SendButton" Content="发送邮件" Style="{StaticResource PrimaryButton}" Click="Send_Click" VerticalAlignment="Stretch"/>
                    </Grid>
                </StackPanel></Border>
            </Grid></Border>

            <Border x:Name="CustomerDrawerCollapsedRail" Grid.Column="4" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <Button Content="‹" Style="{StaticResource SecondaryButton}" Width="38" Height="48" Margin="3,14" VerticalAlignment="Top" Click="ToggleCustomerDrawer_Click" ToolTip="展开客户智能侧栏"/>
            </Border>
            <Border x:Name="CustomerDrawerBorder" Grid.Column="4" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Padding="17,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Customer Intelligence" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="LinkStateText" Text="按邮箱自动匹配客户" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="›" Style="{StaticResource SecondaryButton}" Width="38" Height="38" Padding="0" Click="ToggleCustomerDrawer_Click" ToolTip="收起客户智能侧栏"/>
                </Grid></Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="17,15">
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,13">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Email Sales Copilot" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="读取 CRM、Customer Brain 和邮件上下文" Foreground="{DynamicResource Muted}" FontSize="9.5" Margin="0,3,8,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource AiSoft}" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                    <TextBlock x:Name="EmailAiModelText" Text="等待 AI 配置" Foreground="{DynamicResource AiAccentDeep}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="告诉 AI 这封邮件想表达什么" Style="{StaticResource LabelText}" Margin="0,10,0,4"/>
                            <TextBox x:Name="EmailAiInstructionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62"
                                     VerticalContentAlignment="Top" ToolTip="例如：礼貌确认本月合作计划，语气自然，不要催促"/>
                            <WrapPanel Margin="0,9,0,0">
                                <Button x:Name="GenerateEmailDraftButton" Content="立即生成草稿" Style="{StaticResource PrimaryButton}"
                                        Click="GenerateEmailDraft_Click" Padding="9,4" Margin="0,0,6,5" IsEnabled="False"/>
                                <Button x:Name="UseEmailDraftButton" Content="填入邮件" Style="{StaticResource SecondaryButton}"
                                        Click="UseEmailDraft_Click" Padding="9,4" Margin="0,0,6,5" IsEnabled="False"/>
                            </WrapPanel>
                            <TextBlock Text="AI 只生成草稿，不会自动发送；请核对主题、正文、价格和承诺后手动点击发送。" Foreground="{DynamicResource Muted}" FontSize="8.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,13">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="最近一次 AI 邮件产出" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="EmailAiStatusText" Text="尚无产出" Foreground="{DynamicResource Primary}" FontSize="9.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="EmailAiConfidenceText" Grid.Column="1" Text="—" Foreground="{DynamicResource Muted}" FontSize="8.5" VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock x:Name="EmailAiSubjectText" Text="主题：等待生成" FontWeight="SemiBold" FontSize="9.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource SurfaceInput}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,7,0,0">
                                <TextBlock x:Name="EmailAiBodyText" Text="生成的邮件正文会显示在这里。" FontSize="9.5" TextWrapping="Wrap" MaxHeight="150"/>
                            </Border>
                            <TextBlock x:Name="EmailAiSummaryText" Text="上下文摘要：—" FontSize="9" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EmailAiNextActionText" Text="下一步：—" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EmailAiKnowledgeText" Text="知识参考：尚未生成" Foreground="{DynamicResource Muted}" FontSize="8.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AiCard}" Padding="13" Margin="0,0,0,13">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <controls:ScoreRing x:Name="AiSidebarScoreRing" Width="94" Height="94" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                    <TextBlock Text="AI SALES BRIEF" Style="{StaticResource PageEyebrow}"/>
                                    <TextBlock x:Name="AiSidebarBrainMetaText" Text="CUSTOMER BRAIN · 等待客户上下文"
                                               Foreground="{DynamicResource AiAccent}" FontSize="8.5" FontWeight="SemiBold"
                                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AiSidebarConfidenceText" Text="等待关联客户" FontWeight="SemiBold" Margin="0,5,0,4"/>
                                    <ProgressBar x:Name="AiSidebarConfidenceBar" Height="5" Maximum="100" Foreground="{DynamicResource AiAccent}"/>
                                    <TextBlock x:Name="AiSidebarProfileText" Text="选择会话或填写收件邮箱后显示客户画像"
                                               Foreground="{DynamicResource Muted}" FontSize="9.5" LineHeight="15"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="{DynamicResource PrimarySurface}" CornerRadius="8" Padding="9,6" Margin="0,10,0,0">
                                <TextBlock x:Name="AiSidebarNextActionText" Text="下一步：等待客户上下文"
                                           Foreground="{DynamicResource PrimaryDark}" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource PrimarySoft}" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="邮件与 CRM 已联动" Foreground="{DynamicResource Primary}" FontWeight="SemiBold"/><TextBlock Text="保存后，客户列表、商机智能、Customer Brain、客户分析和邮件自动化任务都会读取这份资料。" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                    <TextBlock Text="姓名" Style="{StaticResource LabelText}" Margin="0,14,0,4"/><TextBox x:Name="NameBox"/>
                    <TextBlock Text="邮箱" Style="{StaticResource LabelText}" Margin="0,10,0,4"/><TextBox x:Name="CustomerEmailBox"/>
                    <TextBlock Text="国家" Style="{StaticResource LabelText}" Margin="0,10,0,4"/><TextBox x:Name="CountryBox"/>
                    <TextBlock Text="阶段" Style="{StaticResource LabelText}" Margin="0,10,0,4"/><ComboBox x:Name="StageBox" DisplayMemberPath="Label"/>
                    <TextBlock Text="负责人" Style="{StaticResource LabelText}" Margin="0,10,0,4"/><TextBox x:Name="OwnerBox"/>
                    <TextBlock Text="标签（逗号分隔）" Style="{StaticResource LabelText}" Margin="0,10,0,4"/><TextBox x:Name="TagsBox"/>
                    <TextBlock Text="人工备注" Style="{StaticResource LabelText}" Margin="0,10,0,4"/>
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalContentAlignment="Top"
                             ToolTip="仅保存销售人员手动记录，不会被最新邮件内容覆盖。"/>
                    <Border Background="{DynamicResource AiSurface}" BorderBrush="{DynamicResource AiSoft}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="AI 上下文总结" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AiContextStatusText" Text="等待关联客户" Foreground="{DynamicResource AiAccent}" FontSize="9.5" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="RefreshAiContextButton" Grid.Column="1" Content="刷新总结" Style="{StaticResource GhostButton}"
                                        Click="RefreshAiContext_Click" Padding="10,6" IsEnabled="False"
                                        ToolTip="使用“客户列表 / Customer Brain”板块模型重新总结，会消耗 Token。"/>
                            </Grid>
                            <TextBlock x:Name="AiContextSummaryText" Text="关联客户后，将综合 WhatsApp 与邮件历史生成态度、性格、语气和当前关系摘要。"
                                       Foreground="{DynamicResource Ink}" TextWrapping="Wrap" LineHeight="17" Margin="0,9,0,0"/>
                            <TextBlock x:Name="AiContextMetaText" Text="客户原文是证据；人工备注与 AI 推断会分开标注。"
                                       Foreground="{DynamicResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
                <Button Grid.Row="2" x:Name="SaveCustomerButton" Content="保存并同步客户" Style="{StaticResource PrimaryButton}" Click="SaveCustomer_Click" Margin="15"/>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
